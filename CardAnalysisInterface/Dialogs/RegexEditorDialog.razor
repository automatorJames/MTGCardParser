@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<CustomDialog OnBackdropClick="HandleCancel">
    <DialogContent>
        @* Header Section *@
        <div class="header-row">
            <span class="header-title">
                @Line.SourceText.CorpusMemberName
            </span>

            <span class="small-box-label header-line-number">
                @($"Line #{Line.SourceText.LineIndex + 1}")
            </span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 16px;">

            @* 1. THE TEXT PREVIEW (Layered) *@
            <div class="line-text-container">
                @{
                    var displaySegments = GetProcessedSegments();
                }

                <div class="text-layer-back">
                    @foreach (var segment in displaySegments)
                    {
                        <span class="highlight-token @segment.UnderlineClass">@segment.Text</span>
                    }
                </div>

                <div class="text-layer-front">
                    @foreach (var segment in displaySegments)
                    {
                        <span style="color: @segment.Color">@segment.Text</span>
                    }
                </div>
            </div>

            <div style="border-top: 1px dashed var(--outline-grey); margin-bottom: 16px;" />

            @* 2. THE INPUT SECTION *@
            <div>
                <div class="autocomplete-container">
                    <label for="regex-input-field" style="color: #A0AEC0; margin-bottom: 4px; display: block;">Regular expression template</label>
                    <div @ref="_editorElement"
                         @key=@("regexInputField")
                         id="regex-input-field"
                         class="regex-input-composite form-control"
                         contenteditable="true"
                         spellcheck="false"
                         @onkeydown="OnKeyDown"
                         placeholder="@(_isEditorEmpty ? "Type text or @ to see templates" : "")">
                    </div>

                    @if (_isDropdownVisible)
                    {
                        <div id="autocomplete-dropdown-list" class="autocomplete-dropdown">
                            @foreach (var (suggestedType, index) in _autocompleteSuggestions.Select((s, i) => (s, i)))
                            {
                                <div id="@($"autocomplete-item-{index}")"
                                     class="autocomplete-item @(index == _selectedSuggestionIndex ? "selected" : "")"
                                     @onclick="() => SelectSuggestionByKeyboard(suggestedType)">

                                    <span class="type-name" style="color: @DeterministicPalette.TypePaletteSet[suggestedType].Normal; @(suggestedType.IsEnum ? "font-style: italic" : "")">
                                        @suggestedType.Name
                                    </span>
                                    <span class="type-kind">@(suggestedType.IsEnum ? "Enum" : "Token Type")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* 3. PREVIEW BOXES *@

                <div style="margin-top: 24px;">
                    <div style="border-top: 1px dashed var(--outline-grey); margin-bottom: 16px;" />

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <div>
                            <div class="small-box-label right">Rendered regex</div>
                            <div class="rendered-regex-box">
                                <pre>
                                    @foreach (var segment in _regexSegments)
                                    {
                                    <span style=@($"color: {segment.Color}")>@segment.Text</span>
                                    }
                                </pre>
                            </div>
                        </div>

                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 4px;">
                                <div class="class-name-wrapper">
                                    @if (_isEditingClassName)
                                    {
                                        <div class="class-name-grid">
                                            <span class="grid-sizer">@ClassName</span>
                                            <input class="class-name-input"
                                                   value="@ClassName"
                                                   spellcheck="false"
                                                   @oninput="(e) => ClassName = e.Value?.ToString() ?? ClassName"
                                                   @onblur="StopEditingClassName"
                                                   @onkeydown="HandleClassNameKeyDown" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="class-name-display" @onclick="StartEditingClassName">
                                            <span class="name-text">@ClassName</span>
                                            <i class="fas fa-pencil-alt edit-icon"></i>
                                        </div>
                                    }
                                </div>
                                <div class="small-box-label right">C# class preview</div>
                            </div>
                            <div class="rendered-regex-box">
                                <pre class="c-sharp">@(new MarkupString(_dynamicTokenType?.ClassStringForDisplayingHtml ?? ""))</pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (_isPillMenuVisible)
        {
            <GenericContextMenu T="TokenModifier"
                                IsVisible="_isPillMenuVisible"
                                X="_menuX"
                                Y="_menuY"
                                ShowDelete="true"
                                OnClicked="HandlePillModifier"
                                OnDelete="HandlePillDelete"
                                OnClose="() => _isPillMenuVisible = false" />
        }
    </DialogContent>

    <DialogActions>
        <button class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveClassToFile">Save Class</button>
    </DialogActions>
</CustomDialog>

<style>
    [contenteditable=true]:empty:before {
        content: attr(placeholder);
        color: #718096;
        pointer-events: none;
        display: block;
    }

    /* Support for context menu display within dialog */
    .mud-dialog-content, .modal-body, .custom-dialog-content {
        overflow: visible !important;
    }
</style>