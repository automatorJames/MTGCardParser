@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<CustomDialog OnBackdropClick="HandleCancel">
    <DialogContent>
        @* Header Section *@
        <div class="header-row">
            <span class="header-title">
                @Line.SourceText.CorpusMemberName
            </span>

            <span class="small-box-label header-line-number">
                @($"Line #{Line.SourceText.LineIndex + 1}")
            </span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 16px;">

            @* 1. THE TEXT PREVIEW (Layered) *@
            <div class="line-text-container">
                <div class="text-layer-back">
                    @{
                        int cursorBack = 0;
                        string textBack = Line.SourceText.FormattedText;
                        foreach (var match in _currentMatches.OrderBy(m => m.Index))
                        {
                            if (match.Index > cursorBack)
                            {
                                @textBack.Substring(cursorBack, match.Index - cursorBack)
                            }
                            <span class="highlight-token">@match.Value</span>
                            cursorBack = match.Index + match.Length;
                        }
                        if (cursorBack < textBack.Length)
                        {
                            @textBack.Substring(cursorBack)
                        }
                    }
                </div>

                <div class="text-layer-front">
                    @{
                        int cursorFront = 0;
                        string textFront = Line.SourceText.FormattedText;

                        foreach (var spanRoot in Line.SpanRoots)
                        {
                            if (spanRoot.RootToken.Match.RootMatch.Index > cursorFront)
                            {
                                @textFront.Substring(cursorFront, spanRoot.RootToken.Match.RootMatch.Index - cursorFront)
                            }

                            var match = spanRoot.RootToken.Match.RootMatch;
                            var tokenText = textFront.Substring(match.Index, match.Length);
                            var color = spanRoot.RootToken.Type == typeof(DefaultUnmatchedString) ? "#E2E8F0" : spanRoot.Palette.Normal;

                            <span style="color: @color">@tokenText</span>

                            cursorFront = match.Index + match.Length;
                        }

                        if (cursorFront < textFront.Length)
                        {
                            @textFront.Substring(cursorFront)
                        }
                    }
                </div>
            </div>

            @* 2. THE INPUT SECTION *@
            <div>
                <div class="autocomplete-container">
                    <label for="regex-input-field" style="color: #A0AEC0; margin-bottom: 4px; display: block;">Regular expression template</label>
                    <div @ref="_editorElement"
                         @key=@("regexInputField")
                         id="regex-input-field"
                         class="regex-input-composite form-control"
                         contenteditable="true"
                         spellcheck="false"
                         @onkeydown="OnKeyDown"
                         placeholder="@(_isEditorEmpty ? "Type text or @ to see templates" : "")">
                    </div>

                    @if (_isDropdownVisible)
                    {
                        <div id="autocomplete-dropdown-list" class="autocomplete-dropdown">
                            @foreach (var (suggestedType, index) in _autocompleteSuggestions.Select((s, i) => (s, i)))
                            {
                                <div id="@($"autocomplete-item-{index}")"
                                     class="autocomplete-item @(index == _selectedSuggestionIndex ? "selected" : "")"
                                     @onclick="() => SelectSuggestionByKeyboard(suggestedType)">

                                    <span class="type-name" style="color: @DeterministicPalette.TypePaletteSet[suggestedType].Normal; @(suggestedType.IsEnum ? "font-style: italic" : "")">
                                        @suggestedType.Name
                                    </span>
                                    <span class="type-kind">@(suggestedType.IsEnum ? "Enum" : "Token Type")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* 3. PREVIEW BOXES *@
                @if (_showPreviewBoxes)
                {
                    <div style="margin-top: 24px;">
                        <div style="border-top: 1px dashed var(--outline-grey); margin-bottom: 16px;" />

                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <div class="small-box-label right">Rendered regex</div>
                                <div class="rendered-regex-box">
                                    <pre>@foreach(var segment in _regexSegments){
                                    <span style="color: @segment.Color">@segment.Text</span>
                                }
</pre>
                            </div>
                        </div>

                        <div>
                            <div class="small-box-label right">C# class preview</div>
                            <div class="rendered-regex-box">
                                <pre class="c-sharp">@(new MarkupString(_dynamicTokenType?.ClassStringStyled ?? ""))</pre>
                            </div>
                        </div>
                    </div>
                </div>
                                }
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <button class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
        <button class="btn btn-primary" @onclick="HandleSubmit">Preview</button>
    </DialogActions>
</CustomDialog>

<style>
    [contenteditable=true]:empty:before {
        content: attr(placeholder);
        color: #718096;
        pointer-events: none;
        display: block;
    }
</style>