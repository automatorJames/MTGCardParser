@* @page "/type-regex"
@inject CorpusAnalyzer CorpusAnalyzer
@inject IJSRuntime JSRuntime
@inject RuntimeSettings RuntimeSettings
@using System.Text
@using MTGPlexer.Colors
@using MTGPlexer.CommonDTOs
@using MTGPlexer.RegexGeneration
@using MTGPlexer.TokenUnitGraphComponents
@using Microsoft.AspNetCore.Components

<div class="type-card-container">
    @foreach (var tokenUnitCapture in GetFilteredTokenUnitCaptures())
    {
        var borderColorStyle = "color: var(--grey);";
        <div class="type-card" style=@borderColorStyle @key=tokenUnitCapture.Type.Name>
            <div class="card-header">
                <TokenTypeName TokenType=@tokenUnitCapture.Type />
                <span class="match-count @(tokenUnitCapture.OccurrenceCount == 0 ? "zero" : "")">
                    <i class="matches-label">matches:</i> @tokenUnitCapture.OccurrenceCount
                </span>
            </div>

            <CopyButtonOverlay TextToCopy=@(RuntimeSettings.ShowMinified? tokenUnitCapture.MinifiedRegexString: tokenUnitCapture.FormattedRegexString)>
                @if (RuntimeSettings.ShowMinified)
                {
                    <pre style=@(borderColorStyle + " white-space: pre-wrap;")>
                    <code>@tokenUnitCapture.MinifiedRegexString</code>
                            </pre>
                }
                else
                {
                    <FormattedRegex Lines=@tokenUnitCapture.FilteredLines BorderStyle=@borderColorStyle />
                }
            </CopyButtonOverlay>

            <PropCaptureCountSection TokenUnitCapture=@tokenUnitCapture />
        </div>

    }
</div>

@code {

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("initializeTypeExpressionsHover");
    }

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    List<TokenUnitCapture> GetFilteredTokenUnitCaptures()
    {
        List<TokenUnitCapture> filteredTokenUnitCaptures = CorpusAnalyzer.TokenCaptureSummary.TokenUnitCaptures.Values.ToList();

        if (!RuntimeSettings.HideRegexesWithZeroCaptures)
            filteredTokenUnitCaptures.AddRange(CorpusAnalyzer.TokenCaptureSummary.UnmatchedTokenUnits.Values);

        var searchTerm = RuntimeSettings.SearchTerm;

        if (string.IsNullOrWhiteSpace(searchTerm))
            return filteredTokenUnitCaptures;

        var term = searchTerm.Trim();

        return filteredTokenUnitCaptures
            .Where(x =>
                x.Type.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || x.Type.Name.ToFriendlyCase().Contains(term, StringComparison.OrdinalIgnoreCase)
                || x.MinifiedRegexString.Contains(term, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
} *@