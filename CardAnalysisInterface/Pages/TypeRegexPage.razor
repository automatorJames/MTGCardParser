@page "/type-regex"
@inject DocumentCorpusAnalyzer DocumentAnalyzer
@inject IJSRuntime JSRuntime
@inject RuntimeSettings RuntimeSettings
@using System.Text
@using MTGPlexer.Colors
@using MTGPlexer.CommonDTOs
@using MTGPlexer.RegexGeneration
@using Microsoft.AspNetCore.Components

<style>
    :root {
        --hover-fade-duration: @(HoverTreatmentConfig.FadeDurationMs)ms;
        --lowlight-opacity: @(HoverTreatmentConfig.LowlightOpacity);
    }
</style>

@if (!_isInitialized)
{
    <LoadingIndicator Label="Analyzing cards..." />
}
else
{
    <div class="type-card-container">
        @foreach (var summary in GetFilteredSummaries())
        {
            var borderColorStyle = "color: var(--grey);";

            <div class="type-card" style=@borderColorStyle @key=summary.Type.Name>
                <div class="card-header">
                    <TokenTypeName TokenType=@summary.Type />
                    <span class="match-count @(summary.OccurrenceCount == 0 ? "zero" : "")">
                        <i class="matches-label">matches:</i> @summary.OccurrenceCount
                    </span>
                </div>

                <CopyButtonOverlay TextToCopy=@(RuntimeSettings.ShowMinified ? summary.RegexGraph.BuiltRegex.MinifiedRegex : summary.RegexGraph.BuiltRegex.ToSmartRegex(summary, summary.RegexGraph, !RuntimeSettings.HideBlankLines).ToString())>
                    @if (RuntimeSettings.ShowMinified)
                    {
                        <pre style=@(borderColorStyle + " white-space: pre-wrap;")>
                    <code>@summary.RegexGraph.BuiltRegex.MinifiedRegex</code>
                            </pre>
                    }
                    else
                    {
                        var smartRegex = summary.RegexGraph.BuiltRegex.ToSmartRegex(summary, summary.RegexGraph, !RuntimeSettings.HideBlankLines);
                        <FormattedRegex Lines=@smartRegex.Lines BorderStyle=@borderColorStyle />
                    }
                </CopyButtonOverlay>

                @if (!RuntimeSettings.HideTypeTree)
                {
                    <TypeTreeView RegexGraph=@summary.RegexGraph />
                }
            </div>

        }
    </div>
}

@code {
    bool _isInitialized;
    bool _hoverInitialized;

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // See CardLinesPage for why this happens in OnAfterRenderAsync rather than OnInitializedAsync.
        if (!_isInitialized)
        {
            await DocumentAnalyzer.EnsureInitializedAsync();
            _isInitialized = true;
            StateHasChanged();
            return;
        }

        if (!_hoverInitialized)
        {
            _hoverInitialized = true;
            await JSRuntime.InvokeVoidAsync("initializeTypeExpressionsHover", new
            {
                HoverTreatmentConfig.PathAncestorDimOpacity,
                HoverTreatmentConfig.LowlightOpacity,
                HoverTreatmentConfig.DebounceMs,
                HoverTreatmentConfig.FadeDurationMs,
                HoverTreatmentConfig.OvershootBrightnessBoost,
                HoverTreatmentConfig.OvershootDurationMs,
                HoverTreatmentConfig.OvershootSettleDurationMs,
            });
        }
    }

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    List<TokenOccurrenceSummary> GetFilteredSummaries()
    {
        List<TokenOccurrenceSummary> filteredSummaries = DocumentAnalyzer.TokenOccurrenceSummaries.Values.ToList();

        if (RuntimeSettings.HideRegexesWithZeroCaptures)
            filteredSummaries = filteredSummaries.Where(x => x.OccurrenceCount > 0).ToList();

        var searchTerm = RuntimeSettings.SearchTerm;

        if (string.IsNullOrWhiteSpace(searchTerm))
            return filteredSummaries;

        var term = searchTerm.Trim();

        return filteredSummaries
            .Where(x =>
                x.Type.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || x.TypeNameFriendly.Contains(term, StringComparison.OrdinalIgnoreCase)
                || x.RegexGraph.BuiltRegex.MinifiedRegex.Contains(term, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
