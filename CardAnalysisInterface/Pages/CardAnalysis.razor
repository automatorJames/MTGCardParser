@page "/"
@page "/card-analysis"
@inject IJSRuntime JSRuntime
@inject CorpusAnalyzer CorpusAnalyzer
@inject RuntimeSettings RuntimeSettings
@implements IDisposable

<div class="analyzed-card-container" id="card-analysis">
    @foreach (var card in GetFilteredCards())
    {
        <CardBlock Card=card />
    }
</div>

@code {

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("initCardCaptureHover");
    }

    IEnumerable<ProcessedCard> GetFilteredCards()
    {
        IEnumerable<ProcessedCard> cards = CorpusAnalyzer.ProcessedCards;

        if (RuntimeSettings.HideFullyMatchedCards)
        {
            cards = cards.Where(x => !x.IsFullyMatched);
        }

        var searchTerm = RuntimeSettings.SearchTerm;
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return cards;
        }

        var term = searchTerm.Trim();

        Func<ProcessedCard, bool> containsPredicate = card =>
            card.Card.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            card.Lines.Any(line => line.SpanRoots.Any(sr => sr.OriginalLineText.Contains(term, StringComparison.OrdinalIgnoreCase)));

        Func<ProcessedCard, bool> startsWithPredicate = card =>
            card.Card.Name.StartsWith(term, StringComparison.OrdinalIgnoreCase) ||
            card.Lines.Any(line => line.SpanRoots.Any(sr => sr.OriginalLineText.StartsWith(term, StringComparison.OrdinalIgnoreCase)));

        return cards
            .Where(containsPredicate)
            .OrderByDescending(startsWithPredicate)
            .ThenBy(c => c.Card.Name);
    }

    public void Dispose()
    {
        RuntimeSettings.OnChanged -= StateHasChanged;
        // Also call the JS cleanup function on disposal
        JSRuntime.InvokeVoidAsync("disposeCardCaptureHover").AsTask();
    }
}