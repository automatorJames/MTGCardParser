@page "/"
@page "/card-lines"
@inject IJSRuntime JSRuntime
@inject DocumentCorpusAnalyzer DocumentAnalyzer
@inject RuntimeSettings RuntimeSettings

@if (!_isInitialized)
{
    <LoadingIndicator Label="Analyzing cards..." />
}
else
{
    <div class="analyzed-card-container" id="card-lines">
        @foreach (var card in GetFilteredCards())
        {
            //<CardBlock Card=card />
            @card.Document.Name
        }
    </div>
}

@code {
    bool _isInitialized;

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += StateHasChanged;
    }

    bool _hoverInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // OnInitializedAsync is fully awaited during static prerendering, so kicking off
        // EnsureInitializedAsync there would block the initial HTTP response and the
        // loading indicator would never actually reach the browser. OnAfterRenderAsync
        // only runs against the live circuit, so it's used instead to load data after
        // the loading indicator has already been rendered.
        if (!_isInitialized)
        {
            await DocumentAnalyzer.EnsureInitializedAsync();
            _isInitialized = true;
            StateHasChanged();
            return;
        }

        // The hover script attaches to #card-lines, which only exists once loading
        // has finished, so wait for that render rather than relying on firstRender.
        if (!_hoverInitialized)
        {
            _hoverInitialized = true;
            await JSRuntime.InvokeVoidAsync("initCardCaptureHover");
        }
    }

    IEnumerable<ProcessedDocument> GetFilteredCards()
    {
        IEnumerable<ProcessedDocument> cards = DocumentAnalyzer.ProcessedDocuments;

        if (RuntimeSettings.HideFullyMatchedCards)
            cards = cards.Where(x => !x.IsFullyMatched);

        var searchTerm = RuntimeSettings.SearchTerm;
        if (string.IsNullOrWhiteSpace(searchTerm))
            return cards;

        var term = searchTerm.Trim();

        Func<ProcessedDocument, bool> containsPredicate = x =>
            x.Document.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            x.Lines.Any(line => line.TokenUnits.Any(x => x.CaptureContext.SourceText.Contains(term, StringComparison.OrdinalIgnoreCase)));

        Func<ProcessedDocument, bool> startsWithPredicate = x =>
            x.Document.Name.StartsWith(term, StringComparison.OrdinalIgnoreCase) ||
            x.Lines.Any(line => line.TokenUnits.Any(x => x.CaptureContext.SourceText.StartsWith(term, StringComparison.OrdinalIgnoreCase)));

        return cards
            .Where(containsPredicate)
            .OrderByDescending(startsWithPredicate)
            .ThenBy(c => c.Document.Name);
    }
}