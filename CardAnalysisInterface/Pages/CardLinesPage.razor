@page "/"
@page "/card-lines"
@inject IJSRuntime JSRuntime
@inject CorpusAnalyzer CorpusAnalyzer
@inject RuntimeSettings RuntimeSettings

<div class="analyzed-card-container" id="card-lines">
    @foreach (var card in GetFilteredCards())
    {
        <CardBlock Card=card />
    }
</div>

@code {

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("initCardCaptureHover");
    }

    IEnumerable<ProcessedDocument> GetFilteredCards()
    {
        IEnumerable<ProcessedDocument> cards = CorpusAnalyzer.ProcessedCards;

        if (RuntimeSettings.HideFullyMatchedCards)
            cards = cards.Where(x => !x.IsFullyMatched);

        var searchTerm = RuntimeSettings.SearchTerm;
        if (string.IsNullOrWhiteSpace(searchTerm))
            return cards;

        var term = searchTerm.Trim();

        Func<ProcessedDocument, bool> containsPredicate = card =>
            card.Document.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            card.Lines.Any(line => line.TokenUnits.Any(x => x.CaptureContext.SourceText.Contains(term, StringComparison.OrdinalIgnoreCase)));

        Func<ProcessedDocument, bool> startsWithPredicate = card =>
            card.Document.Name.StartsWith(term, StringComparison.OrdinalIgnoreCase) ||
            card.Lines.Any(line => line.TokenUnits.Any(x => x.CaptureContext.SourceText.StartsWith(term, StringComparison.OrdinalIgnoreCase)));

        return cards
            .Where(containsPredicate)
            .OrderByDescending(startsWithPredicate)
            .ThenBy(c => c.Document.Name);
    }
}