@page "/type-expressions"
@inject CorpusAnalyzer CorpusAnalyzer
@inject IJSRuntime JSRuntime
@inject RuntimeSettings RuntimeSettings
@using System.Text
@using Microsoft.AspNetCore.Components

@{
    var filteredCaptures = GetFilteredTokenUnitCaptures();
}

<div class="type-card-container">
    @foreach (var tokenUnitCapture in filteredCaptures)
    {
        <div class="type-card" @key=tokenUnitCapture.Type.Name>
            <div class="card-header">
                <TokenTypeName TokenType=@tokenUnitCapture.Type />
                <span class="match-count @(tokenUnitCapture.OccurrenceCount == 0 ? "zero" : "")">
                    <i class="matches-label">matches:</i> @tokenUnitCapture.OccurrenceCount
                </span>
            </div>

            @if (RuntimeSettings.ShowMinifiedRegex)
            {
                var textToCopy = tokenUnitCapture.RegexString;
                var isCopied = _recentlyCopiedText.Contains(textToCopy);
                <div class="pre-container" @onclick="() => CopyToClipboardAsync(textToCopy)">
                    <div class="copy-prompt @(isCopied ? "copied" : "")">
                        @(isCopied ? "Copied!" : "Click to copy")
                    </div>
                    <pre style=@tokenUnitCapture.Palette.ToColorStyle()><code>@tokenUnitCapture.RegexString</code></pre>
                </div>
            }
            else
            {
                var textToCopy = string.Join("\n", tokenUnitCapture.PrettifiedRegex.Lines.Select(l => l.DisplayText));
                var isCopied = _recentlyCopiedText.Contains(textToCopy);
                <div class="pre-container" @onclick="() => CopyToClipboardAsync(textToCopy)">
                    <div class="copy-prompt @(isCopied ? "copied" : "")">
                        @(isCopied ? "Copied!" : "Click to copy")
                    </div>
                    <pre style=@tokenUnitCapture.Palette.ToColorStyle()>
                    <code>
                            @{
                                // Get highlight state for this specific token unit capture
                                bool isValueHighlightActive = _valueHighlightState.TryGetValue(tokenUnitCapture.Type.Name, out var valueHighlightInfo);
                                bool isGroupHighlightActive = _hoveredPropertyGroupState.TryGetValue(tokenUnitCapture.Type.Name, out var groupHighlightInfo);
                            }
                            @foreach (var line in tokenUnitCapture.PrettifiedRegex.Lines)
                            {
                                var isValueHighlighted = isValueHighlightActive && valueHighlightInfo.LineNumber == line.LineNumber;

                                var isGroupBoundary = isGroupHighlightActive &&
                                                      line.PropertyCaptureGroup == groupHighlightInfo.GroupName &&
                                                      (line.Role == PrettifiedRegexLineRole.CaptureGroupStart || line.Role == PrettifiedRegexLineRole.CaptureGroupEnd);

                                var isInsideHoveredGroup = isGroupHighlightActive &&
                                                           line.PropertyCaptureGroup == groupHighlightInfo.GroupName &&
                                                           line.LineNumber > groupHighlightInfo.StartLine &&
                                                           line.LineNumber < groupHighlightInfo.EndLine;

                                // Build CSS class string
                                var cssClass = "";
                                if (isValueHighlighted) cssClass = "value-highlight";
                                else if (isGroupBoundary) cssClass = "group-boundary-highlight";

                                // Determine content and style
                                var style = isValueHighlighted ? $"background-color: {valueHighlightInfo.HighlightColor};" : "";
                                MarkupString content;

                                if (isValueHighlighted || isGroupBoundary)
                                {
                                    // For full-line highlights, render plain text so the wrapper's color style takes over.
                                    content = new MarkupString(System.Net.WebUtility.HtmlEncode(line.DisplayText));
                                }
                                else
                                {
                                    // Otherwise, render the complex colored line, potentially with white pipe characters.
                                    content = (MarkupString)RenderPrettifiedLine(line, tokenUnitCapture.PrettifiedRegex.HashColumnIndex, isInsideHoveredGroup);
                                }

                        <span class="regex-line @cssClass" style="@style">@content</span>
                            }
                                                        </code>
                                                    </pre>
                </div>
            }


            @if (tokenUnitCapture.RegexPropValueSets.Any())
            {
                <div class="properties-container">
                    @for (int i = 0; i < tokenUnitCapture.RegexPropValueSets.Count; i++)
                    {
                        var propSet = tokenUnitCapture.RegexPropValueSets[i];
                        var propSetPalette = DeterministicPalette.GetFixedRainbowPalette(i);
                        <div class="property-capture-card"
                             style=@($"border-color: {propSetPalette.HexDark};")
                             data-start="@propSet.CaptureGroupPositionStart"
                             data-end="@propSet.CaptureGroupPositionEnd"
                             data-name="@propSet.TerminalRegexPropPath.Prop.Name"
                             @onmouseenter="() => StartPropertyGroupHighlight(tokenUnitCapture, propSet)"
                             @onmouseleave="() => ClearPropertyGroupHighlight(tokenUnitCapture)">
                            <div class="prop-card-header" style="color: @propSetPalette.Hex;">
                                @propSet.TerminalRegexPropPath.PropPathFriendly<br />
                            </div>
                            <div class="prop-card-body">
                                @foreach (var valueSet in propSet.ValueCaptureCounts)
                                {
                                    if (!RuntimeSettings.ShowZeroMatchEnumPropertyCaptures && valueSet.TotalCount == 0)
                                    {
                                        continue;
                                    }
                                    <div class="canonical-representation"
                                         @onmouseenter="() => StartValueHighlight(valueSet, tokenUnitCapture)"
                                         @onmouseleave="() => ClearValueHighlight(tokenUnitCapture)">
                                        <span class="canonical-value">@valueSet.CanonicalRepresentation</span>
                                        <span class="total-count" style=@($"color: {(valueSet.TotalCount == 0 ? "#9a3c3c" : "")}")>@valueSet.TotalCount</span>
                                    </div>

                                    @if (valueSet.VariantCounts.Count > 1)
                                    {
                                        <div class="variants-sub-table">
                                            @foreach (var variant in valueSet.VariantCounts.OrderByDescending(x => x.Value))
                                            {
                                                <div class="capture-variant"
                                                     @onmouseenter="() => StartValueHighlight(valueSet, tokenUnitCapture)"
                                                     @onmouseleave="() => ClearValueHighlight(tokenUnitCapture)">
                                                    <span class="variant-value">@variant.Key</span>
                                                    <span class="variant-count">@variant.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private HashSet<string> _recentlyCopiedText = new();
    private Dictionary<string, (int LineNumber, string HighlightColor)> _valueHighlightState = new();
    private Dictionary<string, (string GroupName, int StartLine, int EndLine)> _hoveredPropertyGroupState = new();

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<TokenUnitCapture> GetFilteredTokenUnitCaptures()
    {
        var allCaptures = CorpusAnalyzer.GlobalTokenUnitCaptureSummary.TokenUnitCaptures;
        var searchTerm = RuntimeSettings.SearchTerm;

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return allCaptures;
        }

        var term = searchTerm.Trim();

        return allCaptures.Where(tuc =>
            tuc.Type.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            tuc.Type.Name.ToFriendlyCase().Contains(term, StringComparison.OrdinalIgnoreCase)
        );
    }

    private void StartValueHighlight(ValueCaptureVariantSet valueSet, TokenUnitCapture tokenUnitCapture)
    {
        if (valueSet.CapturedByPrettyRegexLine >= 0)
        {
            var line = tokenUnitCapture.PrettifiedRegex.Lines.FirstOrDefault(l => l.LineNumber == valueSet.CapturedByPrettyRegexLine);
            if (line?.Palette != null)
            {
                _valueHighlightState[tokenUnitCapture.Type.Name] = (line.LineNumber, line.Palette.HexSat);
                StateHasChanged();
            }
        }
    }

    private void ClearValueHighlight(TokenUnitCapture tokenUnitCapture)
    {
        if (_valueHighlightState.Remove(tokenUnitCapture.Type.Name))
        {
            StateHasChanged();
        }
    }

    private void StartPropertyGroupHighlight(TokenUnitCapture tuc, RegexPropValueSet propSet)
    {
        var propName = propSet.TerminalRegexPropPath.Prop.Name;
        var lines = tuc.PrettifiedRegex.Lines;

        var startLine = lines.FirstOrDefault(l => l.PropertyCaptureGroup == propName && l.Role == PrettifiedRegexLineRole.CaptureGroupStart);
        var endLine = lines.FirstOrDefault(l => l.PropertyCaptureGroup == propName && l.Role == PrettifiedRegexLineRole.CaptureGroupEnd);

        if (startLine != null && endLine != null)
        {
            _hoveredPropertyGroupState[tuc.Type.Name] = (propName, startLine.LineNumber, endLine.LineNumber);
            StateHasChanged();
        }
    }

    private void ClearPropertyGroupHighlight(TokenUnitCapture tuc)
    {
        if (_hoveredPropertyGroupState.Remove(tuc.Type.Name))
        {
            StateHasChanged();
        }
    }

    private async Task CopyToClipboardAsync(string text)
    {
        if (_recentlyCopiedText.Contains(text)) return;
        _recentlyCopiedText.Add(text);
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("copyTextToClipboard", text);
        await Task.Delay(2000);
        _recentlyCopiedText.Remove(text);
        await InvokeAsync(StateHasChanged);
    }

    private string RenderPrettifiedLine(PrettifiedRegexLine line, int hashColumnIndex, bool isInsideHoveredGroup)
    {
        const string darkGrey = "#666666";
        const string midGrey = "#AAAAAA";
        var text = line.DisplayText;

        if (string.IsNullOrEmpty(text)) return string.Empty;

        var sb = new StringBuilder();

        if (line.Palette == null)
        {
            if (hashColumnIndex >= 0 && hashColumnIndex < text.Length && text[hashColumnIndex] == '#')
            {
                string left = System.Net.WebUtility.HtmlEncode(text.Substring(0, hashColumnIndex));
                string right = System.Net.WebUtility.HtmlEncode(text.Substring(hashColumnIndex + 1));
                var hashColor = isInsideHoveredGroup ? "white" : darkGrey;
                sb.Append($"<span style=\"color:{midGrey};\">{left}</span>");
                sb.Append($"<span style=\"color:{hashColor};\">#</span>");
                sb.Append($"<span style=\"color:{midGrey};\">{right}</span>");
            }
            else
                sb.Append($"<span style=\"color:{midGrey};\">{System.Net.WebUtility.HtmlEncode(text)}</span>");

            return sb.ToString();
        }

        var palette = line.Palette;
        var currentSegment = new StringBuilder();
        string currentColor = null;

        for (int i = 0; i < text.Length; i++)
        {
            char c = text[i];
            string nextColor;

            if (i == hashColumnIndex && c == '#')
            {
                nextColor = isInsideHoveredGroup ? "white" : darkGrey;
            }
            else
            {
                bool isLineChar = "─┐│┌└┘".Contains(c);
                if (isLineChar)
                {
                    // If inside a hovered group, and the character is a pipe, make it white.
                    nextColor = (isInsideHoveredGroup && c == '│') ? "white" : palette.HexDark;
                }
                else if (line.Role == PrettifiedRegexLineRole.CaptureGroupStart || line.Role == PrettifiedRegexLineRole.CaptureGroupEnd)
                {
                    nextColor = palette.Hex;
                }
                else
                {
                    nextColor = palette.HexLight;
                }
            }

            if (currentColor == null)
            {
                currentColor = nextColor;
            }

            if (nextColor != currentColor)
            {
                if (currentSegment.Length > 0)
                {
                    sb.Append($"<span style=\"color:{currentColor};\">{System.Net.WebUtility.HtmlEncode(currentSegment.ToString())}</span>");
                    currentSegment.Clear();
                }
                currentColor = nextColor;
            }

            currentSegment.Append(c);
        }

        if (currentSegment.Length > 0)
        {
            sb.Append($"<span style=\"color:{currentColor};\">{System.Net.WebUtility.HtmlEncode(currentSegment.ToString())}</span>");
        }

        return sb.ToString();
    }
}