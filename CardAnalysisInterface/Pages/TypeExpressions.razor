@page "/type-expressions"
@inject CorpusAnalyzer CorpusAnalyzer
@inject IJSRuntime JSRuntime
@inject RuntimeSettings RuntimeSettings
@using System.Text
@using MTGPlexer.CommonDTOs
@using MTGPlexer.RegexGeneration
@using MTGPlexer.TokenUnitComponents
@using Microsoft.AspNetCore.Components
@using MTGPlexer.RegexGeneration.RegexTemplateLines.FormattedLines
@using MTGPlexer.Colors

@{
    var filteredCaptures = GetFilteredTokenUnitCaptures();
}

<div class="type-card-container">
    @foreach (var tokenUnitCapture in filteredCaptures)
    {
        <div class="type-card" @key=tokenUnitCapture.Type.Name>
            <div class="card-header">
                <TokenTypeName TokenType=@tokenUnitCapture.Type />
                <span class="match-count @(tokenUnitCapture.OccurrenceCount == 0 ? "zero" : "")">
                    <i class="matches-label">matches:</i> @tokenUnitCapture.OccurrenceCount
                </span>
            </div>

            @{
                var textToCopy = tokenUnitCapture.FormattedRegex.PrettifiedRegex;
                var isCopied = _recentlyCopiedText.Contains(textToCopy);
                var preStyle = tokenUnitCapture.Palette.ToColorStyle();
            }
            <div class="pre-container" @onclick="() => CopyToClipboardAsync(textToCopy)">
                <div class="copy-prompt @(isCopied ? "copied" : "")">
                    @(isCopied ? "Copied!" : "Click to copy")
                </div>
                <pre class="formatted-regex-fira" style=@preStyle>
                <code>
                    @foreach (var line in tokenUnitCapture.FormattedRegex.CommentedLines)
                    {
                            if (line is RegexCommentedAlternateLine altLine && !tokenUnitCapture.LinesWithMatches.Contains(altLine))
                            {
                                continue;
                            }

                            foreach (var span in line.Spans)
                            {
                                    var style = $"--hex: {span.Palette.Hex}; --hex-light: {span.Palette.HexLight}; --hex-dark: {span.Palette.HexDark}; --hex-sat: {span.Palette.HexSat}; color: {span.Palette.Hex};";
                        <span style="@style"
                              data-path="@span.PathRelativeToRoot"
                              data-highlight="@span.HighlightTreatment"
                              data-lowlight="@span.LowlightTreatment">@span.SpanText</span>
                            }
                            @("\n")
                    }
                    </code>
                </pre>
                <br />
                <pre style=@tokenUnitCapture.Palette.ToColorStyle("white-space: pre-wrap;")>
                <code>@tokenUnitCapture.FormattedRegex.MinifiedRegex</code>
                </pre>
            </div>

            @if (tokenUnitCapture.PropPathVariantSets.Any())
            {
                int propCount = 0;
                <div class="properties-container">
                    @foreach ((var captureGroupPropPath, var captureValueVariantSet) in tokenUnitCapture.PropPathVariantSets)
                    {
                        var propSetPalette = DeterministicPalette.GetFixedRainbowPalette(propCount++);
                        var propCardStyle = $"--hex: {propSetPalette.Hex}; --hex-light: {propSetPalette.HexLight}; --hex-dark: {propSetPalette.HexDark}; --hex-sat: {propSetPalette.HexSat}; border-color: {propSetPalette.HexDark};";

                        <div class="property-capture-card" style="@propCardStyle" data-path=@captureGroupPropPath.PropPathRelativeToRoot>
                            <div class="prop-card-header" style="color: @propSetPalette.Hex;">
                                @captureGroupPropPath.PropPathFriendly
                                <br />
                            </div>
                            <div class="prop-card-body">
                                @foreach (var valueSet in captureValueVariantSet.Values)
                                {
                                    var canonicalStyle = $"--hex: {propSetPalette.Hex}; --hex-light: {propSetPalette.HexLight}; --hex-dark: {propSetPalette.HexDark}; --hex-sat: {propSetPalette.HexSat};";
                                    var dataPath = captureGroupPropPath.PropPathRelativeToRoot.Dot(valueSet.CanonicalValue.ToString());

                                    <div class="canonical-representation" style="@canonicalStyle" data-path=@dataPath>
                                        <span class="canonical-value">@valueSet.CanonicalValueDisplay</span>
                                        <span class="total-count" style=@($"color: {(valueSet.TotalCount == 0 ? "#9a3c3c" : "")}")>@valueSet.TotalCount</span>
                                    </div>

                                    @if (valueSet.VariantCounts.Count > 1)
                                    {
                                        <div class="variants-sub-table">
                                            @foreach (var variant in valueSet.VariantCounts.OrderByDescending(x => x.Value))
                                            {
                                                <div class="capture-variant" data-path=@dataPath>
                                                    <span class="variant-value">@variant.Key</span>
                                                    <span class="variant-count">@variant.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private HashSet<string> _recentlyCopiedText = new();

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeTypeExpressionsHover");
        }
    }

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<TokenUnitCapture> GetFilteredTokenUnitCaptures()
    {
        var searchTerm = RuntimeSettings.SearchTerm;

        if (string.IsNullOrWhiteSpace(searchTerm))
            return CorpusAnalyzer.CaptureSummary.TokenUnitCaptures.Values;

        var term = searchTerm.Trim();

        return CorpusAnalyzer.CaptureSummary.TokenUnitCaptures
            .Where(x =>
                x.Key.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.Key.Name.ToFriendlyCase().Contains(term, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Value);
    }

    private async Task CopyToClipboardAsync(string text)
    {
        if (_recentlyCopiedText.Contains(text)) return;
        _recentlyCopiedText.Add(text);
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("copyTextToClipboard", text);
        await Task.Delay(2000);
        _recentlyCopiedText.Remove(text);
        await InvokeAsync(StateHasChanged);
    }
}