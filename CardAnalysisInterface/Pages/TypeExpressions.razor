@page "/type-expressions"
@inject CorpusAnalyzer CorpusAnalyzer
@inject IJSRuntime JSRuntime
@inject RuntimeSettings RuntimeSettings
@using System.Text
@using MTGPlexer.CommonDTOs
@using MTGPlexer.RegexGeneration
@using MTGPlexer.TokenUnitComponents
@using Microsoft.AspNetCore.Components

@{
    var filteredCaptures = GetFilteredTokenUnitCaptures();
}

<div class="type-card-container">
    @foreach (var tokenUnitCapture in filteredCaptures)
    {
        <div class="type-card" @key=tokenUnitCapture.Type.Name>
            <div class="card-header">
                <TokenTypeName TokenType=@tokenUnitCapture.Type />
                <span class="match-count @(tokenUnitCapture.OccurrenceCount == 0 ? "zero" : "")">
                    <i class="matches-label">matches:</i> @tokenUnitCapture.OccurrenceCount
                </span>
            </div>

            @if (RuntimeSettings.ShowMinifiedRegex)
            {
                var textToCopy = tokenUnitCapture.RegexString;
                var isCopied = _recentlyCopiedText.Contains(textToCopy);
                <div class="pre-container" @onclick="() => CopyToClipboardAsync(textToCopy)">
                    <div class="copy-prompt @(isCopied ? "copied" : "")">
                        @(isCopied ? "Copied!" : "Click to copy")
                    </div>
                    <pre style=@tokenUnitCapture.Palette.ToColorStyle()><code>@tokenUnitCapture.RegexString</code></pre>
                </div>
            }
            else
            {
                var textToCopy = string.Join("\n", tokenUnitCapture.RegexString);
                var isCopied = _recentlyCopiedText.Contains(textToCopy);
                <div class="pre-container" @onclick="() => CopyToClipboardAsync(textToCopy)">
                    <div class="copy-prompt @(isCopied ? "copied" : "")">
                        @(isCopied ? "Copied!" : "Click to copy")
                    </div>
                    <pre class="formatted-regex-fira" style=@tokenUnitCapture.Palette.ToColorStyle()>
                        @tokenUnitCapture.RegexString
                    </pre>
                    <pre style=@tokenUnitCapture.Palette.ToColorStyle("white-space: pre-wrap;")>
                        <code>@tokenUnitCapture.MinifiedRegexString</code>
                    </pre>
                </div>
            }

            @if (tokenUnitCapture.RegexPropValueSets.Any())
            {
                <div class="properties-container">
                    @for (int i = 0; i < tokenUnitCapture.RegexPropValueSets.Count; i++)
                    {
                        var propSet = tokenUnitCapture.RegexPropValueSets[i];
                        var propSetPalette = DeterministicPalette.GetFixedRainbowPalette(i);
                        <div class="property-capture-card"
                             style=@($"border-color: {propSetPalette.HexDark};")
                             data-start="@propSet.CaptureGroupPositionStart"
                             data-end="@propSet.CaptureGroupPositionEnd"
                             data-name="@propSet.TerminalRegexPropPath.Prop.Name">
                            <div class="prop-card-header" style="color: @propSetPalette.Hex;">
                                @propSet.TerminalRegexPropPath.PropPathFriendly<br />
                            </div>
                            <div class="prop-card-body">
                                @foreach (var valueSet in propSet.ValueCaptureCounts)
                                {
                                    if (!RuntimeSettings.ShowZeroMatchEnumPropertyCaptures && valueSet.TotalCount == 0)
                                    {
                                        continue;
                                    }
                                    <div class="canonical-representation">
                                        <span class="canonical-value">@valueSet.CanonicalRepresentation</span>
                                        <span class="total-count" style=@($"color: {(valueSet.TotalCount == 0 ? "#9a3c3c" : "")}")>@valueSet.TotalCount</span>
                                    </div>

                                    @if (valueSet.VariantCounts.Count > 1)
                                    {
                                        <div class="variants-sub-table">
                                            @foreach (var variant in valueSet.VariantCounts.OrderByDescending(x => x.Value))
                                            {
                                                <div class="capture-variant">
                                                    <span class="variant-value">@variant.Key</span>
                                                    <span class="variant-count">@variant.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private HashSet<string> _recentlyCopiedText = new();
    private Dictionary<string, (int LineNumber, string HighlightColor)> _valueHighlightState = new();
    private Dictionary<string, (string GroupName, int StartLine, int EndLine)> _hoveredPropertyGroupState = new();

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<TokenUnitCapture> GetFilteredTokenUnitCaptures()
    {
        var allCaptures = CorpusAnalyzer.GlobalTokenUnitCaptureSummary.TokenUnitCaptures;
        var searchTerm = RuntimeSettings.SearchTerm;

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return allCaptures;
        }

        var term = searchTerm.Trim();

        return allCaptures.Where(tuc =>
            tuc.Type.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            tuc.Type.Name.ToFriendlyCase().Contains(term, StringComparison.OrdinalIgnoreCase)
        );
    }

    private async Task CopyToClipboardAsync(string text)
    {
        if (_recentlyCopiedText.Contains(text)) return;
        _recentlyCopiedText.Add(text);
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("copyTextToClipboard", text);
        await Task.Delay(2000);
        _recentlyCopiedText.Remove(text);
        await InvokeAsync(StateHasChanged);
    }
}