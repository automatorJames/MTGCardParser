@inherits LayoutComponentBase
@implements IDisposable
@inject RuntimeSettings RuntimeSettings
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="page">
    <nav class="top-row px-4">
        <div class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All">Card Analysis</NavLink>
            <NavLink href="type-expressions">Type Expressions</NavLink>
            <NavLink href="span-trees">Span Trees</NavLink>
        </div>

        <div class="top-row-right-items">
            <SearchBar />

            @if (RuntimeSettings.IsLoaded)
            {
                var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
                if (relativePath == "" || relativePath == "card-analysis")
                {
                    <Switch @bind-Value=@RuntimeSettings.HideFullyMatchedCards Label="Hide fully matched" />
                }
                else if (relativePath == "type-expressions")
                {
                }
                else if (relativePath == "span-trees")
                {
                    <IntInput @bind-Value=RuntimeSettings.MinSpanOccurences Color=@ThemeColor.DarkGrey Label="Min occurr." />
                    <IntInput @bind-Value=RuntimeSettings.MinSpanWords Color=@ThemeColor.DarkGrey Label="Min words" />
                    <Switch @bind-Value=@RuntimeSettings.OrderByWordCount Label="Order by word count" />
                    <Switch @bind-Value=@RuntimeSettings.ShowOriginalText Label="Show original text" />
                }
            }
        </div>
    </nav>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private DotNetObjectReference<MainLayout>? _dotNetObjectReference;

    // Define the ordered list of page routes
    private readonly List<string> _pageRoutes = new()
    {
        "/",
        "type-expressions",
        "span-trees"
    };

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RuntimeSettings.EnsureLoadedAsync();

            // Set up the JS interop for keyboard shortcuts
            _dotNetObjectReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initializeLayoutListener", _dotNetObjectReference);
        }
    }

    [JSInvokable]
    public void CyclePage(string direction)
    {
        // Get the current page's relative path
        var currentRelativePath = Navigation.ToBaseRelativePath(Navigation.Uri);

        // The root path "/" is returned as an empty string, so normalize it
        if (string.IsNullOrEmpty(currentRelativePath))
        {
            currentRelativePath = "/";
        }

        var currentIndex = _pageRoutes.IndexOf(currentRelativePath);
        if (currentIndex == -1) return; // Current page not in our list, do nothing

        int nextIndex;

        if (direction == "forward")
        {
            // Move to the next index, wrapping around to the start if at the end
            nextIndex = (currentIndex + 1) % _pageRoutes.Count;
        }
        else // "backward"
        {
            // Move to the previous index, wrapping around to the end if at the start
            nextIndex = (currentIndex - 1 + _pageRoutes.Count) % _pageRoutes.Count;
        }

        Navigation.NavigateTo(_pageRoutes[nextIndex]);
    }

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RuntimeSettings.OnChanged -= OnSettingsChanged;

        // Clean up the JS listener and DotNet reference to prevent memory leaks
        if (_dotNetObjectReference != null)
        {
            _dotNetObjectReference.Dispose();
            try
            {
                JSRuntime.InvokeVoidAsync("disposeLayoutListener");
            }
            catch (JSDisconnectedException) { /* ignored */ }
        }
    }
}