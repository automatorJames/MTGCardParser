@using MTGPlexer.RegexGeneration.Graph.Bricks
@if (Bricks != null)
{
    <pre class="formatted-regex-fira" style="@BorderStyle">
        <code>
            @foreach (var brick in Bricks)
            {
                var path = GetPath(brick);

                @if (string.IsNullOrEmpty(path))
                {
                    <span>@GetIndentedText(brick)</span>
                }
                else
                {
                    var palette = new DeterministicPalette(path).Palette;
                    var style = $"--hex: {palette.Normal}; --hex-light: {palette.Light}; --hex-dark: {palette.Dark}; --hex-sat: {palette.Sat}; color: {palette.Normal};";
                    <span style="@style" data-path="@path" data-highlight="TextToHexSat" data-lowlight="TextToHexDark">@GetIndentedText(brick)</span>
                }
                @("\n")
            }
        </code>
    </pre>
}

@code {
    [Parameter, EditorRequired]
    public List<RegexBrick> Bricks { get; set; }

    [Parameter]
    public string BorderStyle { get; set; }

    static string GetPath(RegexBrick brick) => brick.GroupLineageNames.LastOrDefault();

    static string GetIndentedText(RegexBrick brick) => new string(' ', brick.NestedDepth * 4) + brick.RegexFormatted;
}
