<pre class="formatted-regex-fira" style=@BorderStyle>
    <code>
        @foreach (var line in Lines)
        {
            foreach (var span in line.Spans)
            {
                var style = $"--hex: {span.Palette.Normal}; --hex-light: {span.Palette.Light}; --hex-dark: {span.Palette.Dark}; --hex-sat: {span.Palette.Sat}; color: {span.Palette.Normal};";
                <span style="@style" data-path="@span.FullyQualifiedName">@span.Content</span>
            }
            @("\n")
        }
    </code>
</pre>

@code {

	[Parameter]
	public List<SmartLine> Lines { get; set; }

    [Parameter]
    public string BorderStyle { get; set; }

}
