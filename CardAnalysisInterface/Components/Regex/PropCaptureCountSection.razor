@{ var groups = GetPropertyGroups(); }

@if (groups.Count > 0)
{
    <div class="properties-container">
        @foreach (var group in groups)
        {
            var palette = new DeterministicPalette(group.PropertyName).Palette;
            var cardStyle = $"--hex: {palette.Normal}; --hex-light: {palette.Light}; --hex-dark: {palette.Dark}; --hex-sat: {palette.Sat}; border-color: {palette.Dark};";

            <div class="property-capture-card" style="@cardStyle" data-path="@group.PropertyName">
                <div class="prop-card-header" style="color: @palette.Normal;">
                    @group.PropertyName.ToFriendlyCase(TitleDisplayOption.Title)
                </div>
                <div class="prop-card-body">
                    @foreach (var (value, count) in group.Values)
                    {
                        <div class="canonical-representation" data-path="@group.PropertyName">
                            <span class="canonical-value">@value</span>
                            <span class="total-count">@count</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public List<CaptureTrace> Instances { get; set; }

    List<(string PropertyName, List<(string Value, int Count)> Values)> GetPropertyGroups()
    {
        if (Instances == null || Instances.Count == 0)
            return [];

        return Instances
            .SelectMany(x => x.ChildInstances())
            .Where(x => !string.IsNullOrEmpty(x.CaptureValue))
            .GroupBy(x => x.Name)
            .OrderBy(g => g.Key)
            .Select(g => (
                PropertyName: g.Key,
                Values: g.GroupBy(x => x.CaptureValue)
                    .Select(vg => (Value: vg.Key, Count: vg.Count()))
                    .OrderByDescending(x => x.Count)
                    .ToList()))
            .ToList();
    }
}
