@* @if (TokenUnitCapture.PropPathVariantSets.Any())
{
    <div class="properties-container">
        @for (int i = 0; i < TokenUnitCapture.PropPathVariantSets.Count; i++)
        {
            var captureValueVariantSetWrapper = TokenUnitCapture.PropPathVariantSets.Skip(i).First();
            var captureGroupPropPath = captureValueVariantSetWrapper.Value.ParentPath;
            
            var propSetPalette = _positionalPalettes[i];
            var propCardStyle = $"--hex: {propSetPalette.Normal}; --hex-light: {propSetPalette.Light}; --hex-dark: {propSetPalette.Dark}; --hex-sat: {propSetPalette.Sat}; border-color: {propSetPalette.Dark};";

            <div class="property-capture-card" style="@propCardStyle" data-path=@captureGroupPropPath.PropPathRelativeToRoot>
                <div class="prop-card-header" style="color: @propSetPalette.Normal;">
                    @captureGroupPropPath.PropPathFriendly
                    <br />
                </div>
                <div class="prop-card-body">
                    @foreach (var valueSet in captureValueVariantSetWrapper.Value.SynonymSets.Values)
                    {
                        var canonicalStyle = $"--hex: {propSetPalette.Normal}; --hex-light: {propSetPalette.Light}; --hex-dark: {propSetPalette.Dark}; --hex-sat: {propSetPalette.Sat};";
                        var dataPath = valueSet.ManyOfRelatedPaths ?? captureGroupPropPath.PropPathRelativeToRoot.Dot(valueSet.CanonicalValue.ToString());

                        <div class="canonical-representation" style="@canonicalStyle" data-path=@dataPath>
                            <span class="canonical-value">@valueSet.CanonicalValueDisplay</span>
                            <span class="total-count" style=@($"color: {(valueSet.TotalCount == 0 ? "#9a3c3c" : "")}")>@valueSet.TotalCount</span>
                        </div>

                        @if (valueSet.SynonymCounts.Count > 1)
                        {
                            <div class="variants-sub-table">
                                @foreach (var synonym in valueSet.SynonymCounts.OrderByDescending(x => x.Value))
                                {
                                    var synonymPath = dataPath.Dot(synonym.Key);
                                    <div class="capture-variant" data-path=@synonymPath>
                                        <span class="variant-value">@synonym.Key</span>
                                        <span class="variant-count">@synonym.Value</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@code {

    Dictionary<int, HexPalette> _positionalPalettes;

    [Parameter]
    public TokenUnitCapture TokenUnitCapture { get; set; }

    protected override void OnInitialized()
    {
        _positionalPalettes = DeterministicPalette.GetPositionalPaletteSet(TokenUnitCapture.PropPathVariantSets.Count);
    }

}
 *@