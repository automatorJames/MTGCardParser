@if (Summary.EnumCaptureSummaries.Any())
{
    <div class="properties-container">
        @for (int i = 0; i < _orderedSummaries.Count; i++)
        {
            var (fullyQualifiedName, enumSummary) = _orderedSummaries[i];
            var friendlyName = Summary.RegexGraph.SimpleUniqueNames.GetValueOrDefault(fullyQualifiedName, fullyQualifiedName);

            var propSetPalette = _positionalPalettes[i];
            var propCardStyle = $"--hex: {propSetPalette.Normal}; --hex-light: {propSetPalette.Light}; --hex-dark: {propSetPalette.Dark}; --hex-sat: {propSetPalette.Sat}; border-color: {propSetPalette.Dark};";

            <div class="property-capture-card" style="@propCardStyle" data-path=@fullyQualifiedName>
                <div class="prop-card-header" style="color: @propSetPalette.Normal;">
                    @friendlyName.ToFriendlyCase(TitleDisplayOption.Sentence)
                    <br />
                </div>
                <div class="prop-card-body">
                    @foreach (var member in enumSummary.EnumMemberOccurenceCounts.Keys)
                    {
                        var canonicalStyle = $"--hex: {propSetPalette.Normal}; --hex-light: {propSetPalette.Light}; --hex-dark: {propSetPalette.Dark}; --hex-sat: {propSetPalette.Sat};";
                        var totalCount = enumSummary.EnumMemberOccurenceCounts[member];

                        <div class="canonical-representation" style="@canonicalStyle" data-path=@fullyQualifiedName>
                            <span class="canonical-value">@Extensions.ToFriendlyStringOrPattern(member)</span>
                            <span class="total-count" style=@($"color: {(totalCount == 0 ? "#9a3c3c" : "")}")>@totalCount</span>
                        </div>

                        @if (enumSummary.EnumMembersWithMultipleSynonyms.Contains(member))
                        {
                            <div class="variants-sub-table">
                                @foreach (var synonym in enumSummary.EnumMemberSynonymOccurenceCounts[member].OrderByDescending(x => x.Value))
                                {
                                    <div class="capture-variant" data-path=@fullyQualifiedName>
                                        <span class="variant-value">@synonym.Key</span>
                                        <span class="variant-count">@synonym.Value</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@code {

    Dictionary<int, HexPalette> _positionalPalettes;
    List<KeyValuePair<string, EnumCaptureTraceSummary>> _orderedSummaries;

    [Parameter]
    public TokenOccurrenceSummary Summary { get; set; }

    protected override void OnInitialized()
    {
        _orderedSummaries = Summary.EnumCaptureSummaries.ToList();
        _positionalPalettes = DeterministicPalette.GetPositionalPaletteSet(_orderedSummaries.Count);
    }

}
