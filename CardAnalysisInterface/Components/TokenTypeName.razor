<span data-path=@DataPath
class="token-type-name"
style=@_palette.ToColorStyle()>
    @_displayName
</span>

@code {
    DeterministicPalette _palette;
    string _displayName;

    [Parameter, EditorRequired]
    public Type TokenType { get; set; }

    [Parameter]
    public string DataPath { get; set; }

    [Parameter]
    public int? ManyIndex { get; set; }

    protected override void OnInitialized()
    {
        _palette = TokenTypeRegistry.Palettes[TokenType];
        _displayName = TokenType.Name.Replace("_Many", " (many)").ToFriendlyCase(TitleDisplayOption.Sentence);

        if (ManyIndex.HasValue)
            _displayName += $" #{ManyIndex.Value + 1}";
    }
}
