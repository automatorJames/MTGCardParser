<span data-path=@DataPath
class="token-type-name"
style=@_palette.ToColorStyle()>
    @DisplayName
</span>

@code {
    DeterministicPalette _palette;

    [Parameter, EditorRequired]
    public Type TokenType { get; set; }

    [Parameter]
    public string DataPath { get; set; }

    [Parameter]
    public int? ManyIndex { get; set; }

    [Parameter]
    public string DisplayName { get; set; }

    protected override void OnInitialized()
    {
        _palette = TokenTypeRegistry.Palettes[TokenType];

        if (DisplayName == null)
        {
            DisplayName = TokenType.Name.Replace("_Many", " (many)").ToFriendlyCase(TitleDisplayOption.Sentence);

            if (ManyIndex.HasValue)
                DisplayName += $" #{ManyIndex.Value + 1}";
        }
    }
}
