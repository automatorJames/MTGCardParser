<div class="card-capture-block">
    <div class="card-title">@Card.Card.Name</div>

    @if (_showOriginalText)
    {
        <pre class="full-original-text">@Card.Card.Text</pre>
    }

    @foreach (var line in Card.Lines)
    {
        <div class="line-capture-block match-boundary">
            <div class="line-label dashed-border">Line #@(line.LineIndex + 1)</div>

            <pre class="nested-underline-container" @onclick=@(() => OpenRegexEditorDialog(line))>
                @foreach (var rootNode in line.TokenAnalysisRoots)
                {
                    <TokenAnalysisNodeView Node=@rootNode />
                }
            </pre>

            @foreach (var summary in line.TokenAnalysisRoots.Where(x => x.ElementType != TokenAnalysisElementType.UnmatchedTokenUnitRoot))
            {
                <TokenCaptureSummaryTable Branch=@summary />
            }
        </div>
    }
</div>

@if (_isDialogOpen)
{
    <RegexEditorDialog Line="_selectedLine" OnClose="HandleDialogClose" />
}

@code {
    bool _showOriginalText = false;
    bool _isDialogOpen = false;
    ProcessedLine _selectedLine;

    [Parameter]
    public ProcessedCard Card { get; set; }

    static HashSet<string> _terminals = [".", ";", ".\"", ";\""];

    private void OpenRegexEditorDialog(ProcessedLine line)
    {
        _selectedLine = line;
        _isDialogOpen = true;
        // We call StateHasChanged() to ensure the UI re-renders and shows the dialog.
        StateHasChanged();
    }

    private void HandleDialogClose(string regexResult)
    {
        _isDialogOpen = false; // Hide the dialog

        if (regexResult != null) // Check if the user clicked "Save"
        {
            Console.WriteLine($"User saved new regex: {regexResult}");
            //
            // --> This is where you put your logic to process the new regex.
            //
        }
        else
        {
            Console.WriteLine("Dialog was cancelled.");
        }

        // We need to re-render to hide the dialog.
        StateHasChanged();
    }
}