@inject CorpusAnalyzer CorpusAnalyzer
@inject IJSRuntime JS

<Snackbar @ref="_snackbar" />

<div class="card-capture-block">
    <div class="card-title">@Card.Card.Name</div>

    @foreach (var line in Card.Lines)
    {
        <div class="line-capture-block match-boundary">
            <div class="line-label dashed-border">Line #@(line.SourceText.LineIndex + 1)</div>
            <div class="line-container-parent" style="cursor: pointer" data-path=@line.DataPath>
                <pre class="nested-underline-container" style=@GetLineHeightStyle(line) @onclick=@(() => OpenRegexEditorDialog(line)) data-path=@line.DataPath>
                    @foreach (var rootNode in line.SpanRoots)
                    {
                        <SpanView Node=@rootNode />
                    }
                </pre>

                @foreach (var summary in line.SpanRoots.Where(x => x.ElementType != TokenAnalysisElementType.UnmatchedTokenUnitRoot))
                {
                    <PropertyTable Branch=@summary />
                }
            </div>
        </div>
    }
</div>

@if (_isDialogOpen)
{
    <RegexEditorDialog Line="_selectedLine" OnClose="HandleDialogClose" />
}

@code {
    bool _isDialogOpen = false;
    ProcessedLine _selectedLine;
    Snackbar _snackbar;

    [Parameter]
    public ProcessedCard Card { get; set; }

    static HashSet<string> _terminals = [".", ";", ".\"", ";\""];

    void OpenRegexEditorDialog(ProcessedLine line)
    {
        _selectedLine = line;
        _isDialogOpen = true;
        // We call StateHasChanged() to ensure the UI re-renders and shows the dialog.
        StateHasChanged();
    }

    async Task HandleDialogClose(DynamicTokenType dynamicTokenType)
    {
        _isDialogOpen = false;

        if (dynamicTokenType != null)
        {
            Card = await CorpusAnalyzer.ReprocessCard(Card.Card);
            StateHasChanged();

            await Task.Yield();

            if (dynamicTokenType.LineMetadata?.DataPath is string pathToHighlight)
                await JS.InvokeVoidAsync("flashLineHighlight", pathToHighlight);

            if (_snackbar != null)
            {
                // Do NOT await this if you want the method to finish immediately,
                // OR await it after StateHasChanged so the UI isn't "stuck"
                _ = _snackbar.Show(new MarkupString($"Added type <b>{dynamicTokenType.ClassName}</b>!"));
            }
        }
        else
        {
            StateHasChanged();
        }
    }

    string GetLineHeightStyle(ProcessedLine line)
    {
        int fontSize = 16;
        int lh = 24 + (line.GetDeepestChildDepth() * 8);

        // Calculate only the top half of the extra space
        double topCrop = (lh - fontSize) / 2.0;

        return $"line-height: {lh}px; --top-crop: -{topCrop}px;";
    }
}