@inject CorpusAnalyzer CorpusAnalyzer
@inject IJSRuntime JS

<Snackbar @ref="_snackbar" />

<div class="card-capture-block">
    <div class="card-title">@Card.Document.Name</div>

    @foreach (var line in Card.Lines)
    {
        <div class="line-capture-block match-boundary">
            <div class="line-label dashed-border">Line #@(line.SourceText.LineIndex + 1)</div>
            <div class="line-container-parent" style="cursor: pointer" data-path="@line.DataPath">
                <pre class="nested-underline-container" style="@GetLineHeightStyle(line)" @onclick="@(() => OpenRegexEditorDialog(line))" data-path="@line.DataPath">
                    @foreach (var tokenUnit in line.TokenUnits)
                    {
                        @if (tokenUnit.Type == typeof(DefaultUnmatchedString))
                        {
                            @tokenUnit.CaptureValue
                        }
                        else
                        {
                            <SpanView Node="tokenUnit.CaptureTraceTree" SourceText="line.SourceText.FormattedText" IsRoot="true" />
                        }
                    }
                </pre>

                @foreach (var tokenUnit in line.TokenUnits.Where(x => x.Type != typeof(DefaultUnmatchedString)))
                {
                    <PropertyTable Branch="tokenUnit.CaptureTraceTree" />
                }
            </div>
        </div>
    }
</div>

@if (_isDialogOpen)
{
    <RegexEditorDialog Line="_selectedLine" OnClose="HandleDialogClose" />
}

@code {
    bool _isDialogOpen = false;
    ProcessedLine _selectedLine;
    Snackbar _snackbar;

    [Parameter]
    public ProcessedDocument Card { get; set; }

    void OpenRegexEditorDialog(ProcessedLine line)
    {
        _selectedLine = line;
        _isDialogOpen = true;
        StateHasChanged();
    }

    async Task HandleDialogClose(EditorTokenUnit editorTokenUnit)
    {
        _isDialogOpen = false;

        if (editorTokenUnit != null)
        {
            Card = await CorpusAnalyzer.ReprocessDocument(Card.Document);
            StateHasChanged();

            await Task.Yield();

            if (editorTokenUnit.LineMetadata?.DataPath is string pathToHighlight)
                await JS.InvokeVoidAsync("flashLineHighlight", pathToHighlight);

            if (_snackbar != null)
                _ = _snackbar.Show(new MarkupString($"Added type <b>{editorTokenUnit.ClassName}</b>!"));
        }
        else
        {
            StateHasChanged();
        }
    }

    string GetLineHeightStyle(ProcessedLine line)
    {
        int fontSize = 16;
        int lh = 24 + (line.GetDeepestChildDepth() * 8);
        double topCrop = (lh - fontSize) / 2.0;
        return $"line-height: {lh}px; --top-crop: -{topCrop}px;";
    }
}
