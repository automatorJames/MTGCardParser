@if (Branch.IsCollapsedWrapper())
{
    @foreach (var child in Branch.ChildInstances())
    {
        <PropertyTable Branch="child" />
    }
}
else
{
    var palette = Branch.Palette();
    var leaves = Children.Where(x => !x.IsBranch()).ToList();
    var branches = Children.Where(x => x.IsBranch()).ToList();

    <div class="token-summary-branch" style="margin-top:16px" data-path="@Branch.FullyQualifiedName">
        <div class="token-summary-header" data-path="@Branch.FullyQualifiedName" style="@palette?.ToColorStyle(PaletteVariant.Sat)">
            <span class="token-type-name">@Branch.Name.ToFriendlyCase(TitleDisplayOption.Title)</span>
        </div>

        @if (leaves.Count > 0 || branches.Count > 0)
        {
            <div class="property-table-wrapper">
                <div class="content-box" data-path="@Branch.FullyQualifiedName" style="@palette?.ToColorStyle(PaletteVariant.Dark)">
                    @if (leaves.Count > 0)
                    {
                        <table class="property-capture-table">
                            <thead>
                                <tr><th>Property</th><th>Type</th><th>Value</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var leaf in leaves)
                                {
                                    var leafPalette = leaf.Palette();
                                    <tr data-path="@leaf.FullyQualifiedName">
                                        <td class="prop-capture-table-cell first-column" style="@leafPalette?.ToColorStyle()">
                                            @leaf.Name.ToFriendlyCase(TitleDisplayOption.Title)
                                        </td>
                                        <td class="prop-capture-table-cell type-column" style="@leafPalette?.ToColorStyle()">
                                            @leaf.NodeType
                                        </td>
                                        <td class="prop-capture-table-cell value-column" style="@leafPalette?.ToColorStyle()">
                                            @leaf.CaptureValue
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @* Recursively render tables for children that are also branches *@
                    @foreach (var branch in branches)
                    {
                        <PropertyTable Branch="branch" />
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public CaptureTrace Branch { get; set; }

    IEnumerable<CaptureTrace> Children => Branch.ChildInstances();
}
