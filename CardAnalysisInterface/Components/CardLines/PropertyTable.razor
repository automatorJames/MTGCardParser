
@if (BranchTrace.IsCollapsible)
{
    <!-- Directly render branch children of the collapsed parent branch -->
    @foreach (var child in BranchTrace.Children)
    {
        <PropertyTable BranchTrace=@child />
    }
}
else
{
    <div class="token-summary-branch" style="margin-top:16px" data-path=@BranchTrace.FullyQualifiedName>
        <div class="token-summary-header" data-path=@BranchTrace.FullyQualifiedName style=@(RootPalette.ToColorStyle(PaletteVariant.Sat))>
            <span class="token-type-name">@BranchTrace.Name.ToFriendlyCase(TitleDisplayOption.Title)</span>
        </div>

        @if (BranchTrace.Children.Any())
        {
            <div class="property-table-wrapper">
                <div 
                    class="content-box" data-path=@BranchTrace.FullyQualifiedName style=@(RootPalette.ToColorStyle(PaletteVariant.Dark))>

                    @{
                        var terminals = BranchTrace.Children.Where(x => x.IsTerminal).ToList();
                        if (terminals.Any())
                        {
                            <table class="property-capture-table">
                                <thead>
                                    <tr><th>Property</th><th>Type</th><th>Value</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var leaf in terminals)
                                    {
                                        var leafPaletteStyle = ProcessedLine.CaptureTracePositionalPalettes[leaf].ToColorStyle();
                                        //var subLeafChildren = leaf.Children.OfType<SpanSubLeaf>();
                                        //IEnumerable<SpanLeaf> leafOrSubleaves = subLeafChildren.Any() ? subLeafChildren : [leaf];

                                        //foreach (var leafOrSubleaf in leafOrSubleaves)
                                        //{
                                            <tr data-path="@leaf.FullyQualifiedName">
                                                <td class="prop-capture-table-cell first-column" style=@leafPaletteStyle)>
                                                    @leaf.Name
                                                </td>
                                                <td class="prop-capture-table-cell type-column" style=@(leafPaletteStyle)>
                                                    @leaf.NodeType
                                                </td>
                                                <td class="prop-capture-table-cell value-column" style=@(leafPaletteStyle)>
                                                    @leaf.ClrValue.ToString()
                                                </td>
                                            </tr>
                                        //}
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    <!-- Recursively render tables for children that are also branches -->
                    @foreach (var branch in BranchTrace.Children.Where(x => x.Children.Any()))
                    {
                        <PropertyTable BranchTrace="@branch" />
                    }
                </div>
            </div>
        }
    </div>
}

@code {

    [CascadingParameter]
    public ProcessedLine ProcessedLine { get; set; } = null!;

    [Parameter, EditorRequired]
    public CaptureTrace BranchTrace { get; set; }

    HexPalette RootPalette => ProcessedLine.CaptureTracePositionalPalettes[BranchTrace];
}
