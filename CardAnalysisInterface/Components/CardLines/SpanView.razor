@if (Node.IsCollapsedWrapper())
{
    @foreach (var child in Node.ChildInstances())
    {
        <SpanView Node="child" SourceText="SourceText" Depth="Depth" />
    }
}
else if (Node.IsBranch())
{
    <span class="nested-underline" style="@GetBranchStyle()" data-path="@Node.FullyQualifiedName">
        @foreach (var segment in GetSegments())
        {
            @if (segment.Child is { } child)
            {
                <SpanView Node="child" SourceText="SourceText" Depth="Depth + 1" />
            }
            else
            {
                @segment.Text
            }
        }
    </span>
}
else if (IsRoot)
{
    @* A top-level match with no captured properties at all - just plain text, nothing to highlight *@
    @Node.CaptureValue
}
else
{
    <span class="prop-capture-overline" style="@GetLeafStyle()" data-path="@Node.FullyQualifiedName">@Node.CaptureValue</span>
}

@code {
    [Parameter, EditorRequired]
    public CaptureTrace Node { get; set; }

    [Parameter, EditorRequired]
    public string SourceText { get; set; }

    [Parameter]
    public int Depth { get; set; }

    [Parameter]
    public bool IsRoot { get; set; }

    /// <summary>
    /// Walks this node's children in source order, filling the gaps between them with plain text.
    /// Capture bounds are clamped defensively: overlapping or out-of-range children (which can
    /// happen for nested list-of-TokenUnit captures) are skipped rather than crashing the page.
    /// </summary>
    IEnumerable<(CaptureTrace Child, string Text)> GetSegments()
    {
        var nodeEnd = Math.Min(Node.End, SourceText.Length);
        var cursor = Math.Clamp(Node.Index, 0, nodeEnd);

        foreach (var child in Node.ChildInstances())
        {
            var childStart = Math.Max(child.Index, cursor);
            var childEnd = Math.Min(child.End, nodeEnd);

            if (childEnd <= childStart)
                continue;

            if (childStart > cursor)
                yield return (null, SourceText.Substring(cursor, childStart - cursor));

            yield return (child, null);
            cursor = childEnd;
        }

        if (cursor < nodeEnd)
            yield return (null, SourceText.Substring(cursor, nodeEnd - cursor));
    }

    string GetBranchStyle() => $"padding-bottom: {2 + Depth * 6}px;";

    string GetLeafStyle() =>
        (Node.Palette()?.ToColorStyle() ?? "") + $" padding-bottom: {2 + Depth * 6}px;";
}
