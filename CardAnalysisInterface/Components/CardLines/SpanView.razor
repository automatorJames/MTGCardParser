@using MTGPlexer.RegexGeneration.Graph.Nodes
@if (CaptureNode != null)
{
    <span class=@GetClass(CaptureNode) style=@GetStyle(CaptureNode) data-path="@CaptureNode.CapturePath">
        @{
            var cursor = 0;

            foreach (var child in CaptureNode.Children.OrderBy(c => c.Start))
            {
                var relativeChildStart = child.Start - CaptureNode.Start;

                if (relativeChildStart > cursor)
                {
                    <text>@CaptureNode.CaptureTextOriginal.Substring(cursor, relativeChildStart - cursor)</text>
                }

                <SpanView CaptureNode="@child" Depth="@(Depth + (child is SpanBranch branch && branch.IsCollapsed ? 0 : 1))" />

                cursor = child.End - CaptureNode.Start;
            }

            if (cursor < CaptureNode.Length)
            {
                <text>@CaptureNode.CaptureTextOriginal.Substring(cursor, CaptureNode.Length - cursor)</text>
            }
        }
    </span>
}

@code {
    [Parameter, EditorRequired]
    public CaptureNode CaptureNode { get; set; }

    [Parameter]
    public int Depth { get; set; } = 0;

    string GetClass(CaptureNode node)
    {
        if (node.UnderlyingType == typeof(DefaultUnmatchedString))
            return "";

        var classes = new List<string>();

        if (node is BranchNode && !node.IsCollapsible)
            classes.Add("nested-underline");

        if (node is LeafNoContainer
            classes.Add("prop-capture-overline");

        //if (node is SpanSubLeaf spanSubLeaf)
        //    classes.Add("dashed-line");

        //if (node.ElementType == TokenAnalysisElementType.PlaceholderLeaf)
        //    classes.Add("dotted-line");

        return string.Join(" ", classes);
    }

    string GetStyle(CaptureNode node)
    {
        if (node.UnderlyingType == typeof(DefaultUnmatchedString))
            return "";

        if (node is BranchNode && !node.IsCollapsible)
            return "";

        var style = new System.Text.StringBuilder();

        if (node is IHasPalette hasPalette)
            style.Append(hasPalette.Palette.ToColorStyle());

        var paddingBottom = 2 + (Depth * 6);
        style.Append($" padding-bottom: {paddingBottom}px;");

        return style.ToString();
    }
}