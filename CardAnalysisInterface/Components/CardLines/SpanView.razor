@if (Node != null)
{
    <span class=@GetClass(Node) style=@GetStyle(Node) data-path="@Node.CapturePath">
        @{
            var cursor = 0;

            foreach (var child in Node.Children.OrderBy(c => c.Start))
            {
                if (child is SpanSubLeaf)
                    continue;

                var relativeChildStart = child.Start - Node.Start;

                if (relativeChildStart > cursor)
                {
                    try
                    {
                        <text>@Node.CaptureTextOriginal.Substring(cursor, relativeChildStart - cursor)</text>
                    }
                    catch (Exception ex)
                    {
                        var debugInfo = Node.Debug();
                    }
                }

                <SpanView Node="@child" Depth="@(Depth + (child is SpanBranch branch && branch.IsCollapsed ? 0 : 1))" />

                cursor = child.End - Node.Start;
            }

            if (cursor < Node.Length)
            {
                try
                {
                    <text>@Node.CaptureTextOriginal.Substring(cursor, Node.Length - cursor)</text>
                }
                catch(Exception ex)
                {
                    var debugInfo = Node.Debug();
                }
            }
        }
    </span>
}

@code {
    [Parameter, EditorRequired]
    public SpanAnalysisBase Node { get; set; }

    [Parameter]
    public int Depth { get; set; } = 0;

    string GetClass(SpanAnalysisBase node)
    {
        if (node.ElementType == TokenAnalysisElementType.UnmatchedTokenUnitRoot)
            return "";

        var classes = new List<string>();

        if (node is SpanBranch branch)
            classes.Add("nested-underline");

        if (node is SpanLeaf)
            classes.Add("prop-capture-inline");

        return string.Join(" ", classes);
    }

    string GetStyle(SpanAnalysisBase node)
    {
        if (node.ElementType == TokenAnalysisElementType.UnmatchedTokenUnitRoot)
            return "";

        var style = new System.Text.StringBuilder();

        if (node is SpanBranch branch)
            style.Append(branch.Palette.ToColorStyle());
        else if (node is SpanLeaf leaf)
            style.Append(leaf.Palette.ToColorStyle());

        var paddingBottom = 2 + (Depth * 6);
        style.Append($" padding-bottom: {paddingBottom}px;");

        return style.ToString();
    }
}