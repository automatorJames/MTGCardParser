@if (Branch.IsCollapsed)
{
    @* Directly render branch children of the collapsed parent branch*@
    @foreach (var branch in Branch.Children.OfType<TokenAnalysisBranch>())
    {
        <TokenCaptureSummaryTable Branch="@branch" />
    }
}
else
{
    <div class="token-summary-branch" data-path=@Branch.Path>
        <div class="token-summary-header" style=@(Branch.Palette?.ToColorStyle())>
            <span class="token-type-name">@Branch.Name.ToFriendlyCase(TitleDisplayOption.Title)</span>
        </div>

        @if (Branch.Children.Any())
        {
            <div class="property-table-wrapper">
                <div class="content-box" style=@(Branch.Palette?.ToColorStyle(shift: -1))>

                    @{
                        var leaves = Branch.Children.OfType<TokenAnalysisLeaf>().ToList();
                        if (leaves.Any())
                        {
                            <table class="property-capture-table">
                                <thead>
                                    <tr><th>Property</th><th>Type</th><th>Value</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var leaf in leaves)
                                    {
                                        var subLeafChildren = leaf.Children.OfType<TokenAnalysisSubLeaf>();
                                        IEnumerable<TokenAnalysisLeaf> leafOrSubleaves = subLeafChildren.Any() ? subLeafChildren : [leaf];

                                        foreach (var leafOrSubleaf in leafOrSubleaves)
                                        {
                                            <tr data-path="@leafOrSubleaf.Path">
                                                <td class="prop-capture-table-cell first-column" style=@(leafOrSubleaf.Palette?.ToColorStyle())>
                                                    @leafOrSubleaf.Name
                                                </td>
                                                <td class="prop-capture-table-cell type-column" style=@(leafOrSubleaf.Palette?.ToColorStyle())>
                                                    @leafOrSubleaf.TerminalType
                                                </td>
                                                <td class="prop-capture-table-cell value-column" style=@(leafOrSubleaf.Palette?.ToColorStyle())>
                                                    @leafOrSubleaf.TerminalValString
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @* Recursively render tables for children that are also branches *@
                    @foreach (var branch in Branch.Children.OfType<TokenAnalysisBranch>())
                    {
                        <TokenCaptureSummaryTable Branch="@branch" />
                    }
                </div>
            </div>
        }
    </div>
}



@code {
    [Parameter, EditorRequired]
    public TokenAnalysisBranch Branch { get; set; }
}