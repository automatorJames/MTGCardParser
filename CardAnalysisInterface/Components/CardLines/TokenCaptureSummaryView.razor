@if (Summary != null)
{
    <span class=@GetClass(Summary) style=@GetStyle(Summary) data-path="@Summary.Path">
        @{
            var cursor = Summary.Start;

            // Render children in the order they appear in the text
            foreach (var child in Summary.Children.OrderBy(c => c.Start))
            {
                // Render any text that comes before this child
                if (child.Start > cursor)
                {
                    <span class="twig">@Summary.OriginalFullText.Substring(cursor, child.Start - cursor)</span>
                }
                
                // Recursively render the child summary
                <TokenCaptureSummaryView Summary="@child" />

                // Move the cursor to the end of the child's capture
                cursor = child.End;
            }

            // Render any remaining text after the last child
            if (cursor < Summary.End)
            {
                <span class="twig">@Summary.OriginalFullText.Substring(cursor, Summary.End - cursor)</span>
            }
        }
    </span>
}

@code {
    [Parameter, EditorRequired]
    public TokenCaptureSummary Summary { get; set; }

    private string GetClass(TokenCaptureSummary summary)
    {
        var classes = new List<string>();
        if (summary.UnderlinePalette != null) classes.Add("nested-underline");
        if (summary.OverlinePalette != null) classes.Add("prop-capture-inline");
        return string.Join(" ", classes);
    }

    private string GetStyle(TokenCaptureSummary summary)
    {
        var style = "";
        if (summary.UnderlinePalette != null)
        {
            style += summary.UnderlinePalette.ToColorStyle();
        }
        if (summary.OverlinePalette != null)
        {
            style += $" --overline-color: {summary.OverlinePalette.Hex};";
        }

        var depth = 0;
        var current = summary.Parent;
        while (current != null)
        {
            depth++;
            current = current.Parent;
        }
        var paddingBottom = 2 + (depth * 6);
        style += $" padding-bottom: {paddingBottom}px;";

        return style;
    }
}