<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- As the app runs: the engine allocates heavily, and under workstation GC its timings come out several times the app's. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glyphotype\Glyphotype.csproj" />
    <ProjectReference Include="..\MTGGlyphs\MTGGlyphs.csproj" />
    <ProjectReference Include="..\Glyphotype.Distiller\Glyphotype.Distiller.csproj" />
    <ProjectReference Include="..\MTGRulesIR\MTGRulesIR.csproj" />
  </ItemGroup>

</Project>
