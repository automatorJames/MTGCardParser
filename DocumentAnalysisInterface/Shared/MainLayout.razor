@inherits LayoutComponentBase
@implements IDisposable
@inject RuntimeSettings RuntimeSettings
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="page">
    <nav class="top-row px-4">
        <div class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All">Document Lines</NavLink>
            <NavLink href="type-regex">Type Regex</NavLink>
            <NavLink href="word-trees">Word Trees</NavLink>
        </div>

        <div class="top-row-right-items">

            @if (RuntimeSettings.IsLoaded)
            {
                var pageSettingIcons = GetPageSettingIcons();

                @if (pageSettingIcons.Count > 0)
                {
                    <div class="page-setting-icons">
                        @foreach (var settingIcon in pageSettingIcons)
                        {
                            <SettingIconToggle Icon="@settingIcon.Icon" Label="@settingIcon.Label" Value="@settingIcon.Value"
                                                ValueChanged="@(v => settingIcon.OnChanged(v))" />
                        }
                    </div>
                    <span class="settings-separator"></span>
                }

                <button class="settings-button" data-tooltip="Settings" aria-label="Settings" @onclick="OpenSettingsDialog">
                    <span class="oi oi-cog" aria-hidden="true"></span>
                </button>
            }

            <SearchBar />

        </div>
    </nav>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (_isSettingsDialogOpen)
{
    <SettingsDialog OnClose="CloseSettingsDialog" />
}

@code {
    bool _isSettingsDialogOpen;

    void OpenSettingsDialog() => _isSettingsDialogOpen = true;
    void CloseSettingsDialog() => _isSettingsDialogOpen = false;

    // Define the ordered list of page routes
    private readonly List<string> _pageRoutes = new()
    {
        "/",
        "type-regex",
        "word-trees"
    };

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RuntimeSettings.EnsureLoadedAsync();
    }

    [JSInvokable]
    public void CyclePage(string direction)
    {
        // Get the current page's relative path
        var currentRelativePath = Navigation.ToBaseRelativePath(Navigation.Uri);

        // The root path "/" is returned as an empty string, so normalize it
        if (string.IsNullOrEmpty(currentRelativePath))
        {
            currentRelativePath = "/";
        }

        var currentIndex = _pageRoutes.IndexOf(currentRelativePath);
        if (currentIndex == -1) return; // Current page not in our list, do nothing

        int nextIndex;

        if (direction == "forward")
        {
            // Move to the next index, wrapping around to the start if at the end
            nextIndex = (currentIndex + 1) % _pageRoutes.Count;
        }
        else // "backward"
        {
            // Move to the previous index, wrapping around to the end if at the start
            nextIndex = (currentIndex - 1 + _pageRoutes.Count) % _pageRoutes.Count;
        }

        Navigation.NavigateTo(_pageRoutes[nextIndex]);
    }

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RuntimeSettings.OnChanged -= OnSettingsChanged;
    }

    /// <summary>
    /// The bool-setting quick-toggle icons shown to the left of the settings button, specific to
    /// whichever of the three pages is currently active — lets a viewer flip a view-affecting
    /// setting live without opening the settings dialog.
    /// </summary>
    List<PageSettingIcon> GetPageSettingIcons()
    {
        var currentRelativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrEmpty(currentRelativePath))
        {
            currentRelativePath = "/";
        }

        return currentRelativePath switch
        {
            "/" =>
            [
                new("circle-check", "Hide fully matched", RuntimeSettings.HideFullyMatchedDocuments, v => RuntimeSettings.HideFullyMatchedDocuments = v),
                new("collapse-down", "Show collapsed nodes", RuntimeSettings.ShowCollapsedCaptureNodes, v => RuntimeSettings.ShowCollapsedCaptureNodes = v),
            ],
            "type-regex" =>
            [
                new("bar-chart", "Order by occurrence count", RuntimeSettings.OrderByOccurrenceCount, v => RuntimeSettings.OrderByOccurrenceCount = v),
                new("code", "Show minified", RuntimeSettings.ShowMinified, v => RuntimeSettings.ShowMinified = v),
                new("ban", "Hide zero-capture types", RuntimeSettings.HideRegexesWithZeroCaptures, v => RuntimeSettings.HideRegexesWithZeroCaptures = v),
                new("minus", "Hide blank lines", RuntimeSettings.HideBlankLines, v => RuntimeSettings.HideBlankLines = v),
                new("fork", "Hide type tree", RuntimeSettings.HideTypeTree, v => RuntimeSettings.HideTypeTree = v),
            ],
            "word-trees" =>
            [
                new("sort-ascending", "Order by word count", RuntimeSettings.OrderByWordCount, v => RuntimeSettings.OrderByWordCount = v),
            ],
            _ => [],
        };
    }

    record PageSettingIcon(string Icon, string Label, bool Value, Action<bool> OnChanged);
}