@* One row of color-coded key chips for a word tree card: the document names above the tree, or
   the Glyph type names below it. Both strips are identical apart from which data attribute the
   chips carry, and word-tree-event-handler.ts drives their highlight/lowlight purely off that
   attribute, so keeping them one component means the two key strips can never drift apart
   visually - and means WordTreesPage and EchoTreeDialog share the markup and (thanks to CSS
   isolation scoping to this component rather than to its host) the styling too. *@

<div class="key-strip">
    @foreach (var item in Items)
    {
        var palette = Palettes[item];
        <span class="key-item"
              @attributes=@KeyAttributeFor(item)
              style="border-color: @palette.Normal; --highlight-color: @palette.Light; --sat-color: @palette.Sat;">
            @item
        </span>
    }
</div>

@code {
    /// <summary>The key values to render chips for, in the order they should appear.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Items { get; set; } = [];

    /// <summary>Palette for every value in <see cref="Items"/>.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, HexPalette> Palettes { get; set; } = null!;

    /// <summary>
    /// The data attribute each chip is tagged with - <c>data-document-name</c> or
    /// <c>data-glyph-type</c>. This is the hook the tree's hover handling keys off, so it doubles
    /// as the declaration of which of the two highlight behaviours this strip drives.
    /// </summary>
    [Parameter, EditorRequired]
    public string KeyAttribute { get; set; } = null!;

    Dictionary<string, object> KeyAttributeFor(string item) => new() { [KeyAttribute] = item };
}
