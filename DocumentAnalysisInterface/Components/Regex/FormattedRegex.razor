<pre class="formatted-regex-fira" style="@($"font-family: {SmartRegexStaticRules.PrimaryFontFamily}; {BorderStyle}")">
    <code>
        @for (var i = 0; i < Lines.Count; i++)
        {
            if (ShowLineNumbers)
            {
                @* data-lowlight="None" keeps the gutter out of the hover highlight/lowlight pass -
                   it's chrome, not part of the expression. *@
                <span class="regex-line-number" style="@_lineNumberStyle" data-lowlight="None">@(i + 1)</span>
            }

            foreach (var span in Lines[i].Spans)
            {
                var style = BuildSpanStyle(span.Palette);
                var isInteractive = span.Kind is not { } kind || !HoverTreatmentConfig.NonInteractiveSpanKinds.Contains(kind);
                <span style="@style" data-path="@(isInteractive ? span.FullyQualifiedName : null)">@span.Content</span>
            }
            @("\n")
        }
    </code>
</pre>

@code {

	[Parameter]
	public List<SmartLine> Lines { get; set; }

    [Parameter]
    public string BorderStyle { get; set; }

    /// <summary>
    /// Whether to prefix each line with a dim, right-aligned line number. Callers suppress this for
    /// the single-line minified format.
    /// </summary>
    [Parameter]
    public bool ShowLineNumbers { get; set; }

    /// <summary>
    /// Gutter width, sized to the widest line number so the code column stays flush. This is the
    /// digits only - the gap separating the gutter from the expression is content-box padding in
    /// the stylesheet, so the two never compete for the same space.
    /// </summary>
    string _lineNumberStyle;

    protected override void OnParametersSet() =>
        _lineNumberStyle = $"width: {(Lines?.Count ?? 0).ToString().Length}ch;";

    static string BuildSpanStyle(SpanStylePalette palette)
    {
        var style = $"{palette.CssVariables()} color: {palette.Default};";

        if (palette.IsBold)
            style += " font-weight: bold;";

        if (palette.IsItalic)
            style += " font-style: italic;";

        return style;
    }

}
