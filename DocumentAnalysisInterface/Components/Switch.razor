<label class="switch @(Disabled ? "disabled" : "")">
    <input type="checkbox" checked="@(Value && !Disabled)" disabled="@Disabled" @onchange="OnCheckboxChanged" />
    <span class="slider"></span>
</label>
<label style="margin-left: -16px;" class="switch-label @(Disabled ? "disabled" : "")" title="@DisabledReason">@Label</label>

@code {
    [Parameter]
    public string Label { get; set; }

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Shown, but not offered.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Why it's <see cref="Disabled"/>, for its tooltip.</summary>
    [Parameter]
    public string DisabledReason { get; set; }

    // This method is called when the user clicks the checkbox.
    // It is responsible for invoking the parent's EventCallback.
    private async Task OnCheckboxChanged(ChangeEventArgs e)
    {
        // When the checkbox value changes, we invoke the 'ValueChanged' callback.
        // Blazor's @bind-Value in the parent component listens for this specific callback.
        await ValueChanged.InvokeAsync((bool)e.Value);
    }
}
