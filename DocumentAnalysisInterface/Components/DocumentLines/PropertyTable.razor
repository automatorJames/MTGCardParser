@using DocumentAnalysisInterface.Components.DocumentLines
@inject RuntimeSettings RuntimeSettings

@if (ShouldCollapse)
{
    <!-- Directly render branch children of the collapsed parent branch, carrying its name
         forward so the next rendered header can show the collapsed lineage that led to it. -->
    @foreach (var child in BranchTrace.Children)
    {
        <PropertyTable BranchTrace=@child CollapsedLineage=@ChildLineage />
    }
}
else
{
    <div class="glyph-summary-branch" style="margin-top:16px" data-path=@BranchTrace.FullyQualifiedName>
        <div class="glyph-summary-header" data-path=@BranchTrace.FullyQualifiedName style=@(RootPalette.ToColorStyle(PaletteVariant.Sat))>
            <span class="glyph-type-name">
                @{ var segments = HeaderSegments; }
                @for (var i = 0; i < segments.Count; i++)
                {
                    var segment = segments[i];
                    var isDim = (segments.Count - 1 - i) % 2 != 0;

                    if (segment.SeparatorBefore is { } separatorKind)
                    {
                        @(" ")<span class="header-separator">@SeparatorGlyph(separatorKind)</span>@(" ")
                    }
                    <span class="header-part @(isDim ? "header-part-dim" : "")">@segment.Text</span>
                }
            </span>
        </div>

        @if (BranchTrace.Children.Any())
        {
            <div class="property-table-wrapper">
                <div 
                    class="content-box" data-path=@BranchTrace.FullyQualifiedName style=@(RootPalette.ToColorStyle(PaletteVariant.Dark))>

                    @{
                        var terminals = BranchTrace.Children.Where(x => x.IsTerminal).ToList();

                        if (terminals.Any())
                        {
                            <table class="property-capture-table">
                                <thead>
                                    <tr><th>Property</th><th>Type</th><th>Value</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var leaf in terminals)
                                    {
                                        var leafPaletteStyle = DisplayContext.Palettes[leaf].ToColorStyle();

                                        <tr data-path="@leaf.FullyQualifiedName">
                                            <td class="prop-capture-table-cell first-column" style=@leafPaletteStyle)>
                                                @LeafDisplayName(leaf)
                                            </td>
                                            <td class="prop-capture-table-cell type-column" style=@(leafPaletteStyle)>
                                                @TerminalTypeLabel(leaf)
                                            </td>
                                            <td class="prop-capture-table-cell value-column" style=@(leafPaletteStyle)>
                                                @leaf.ClrValue.ToString()
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    <!-- Recursively render tables for children that are also branches -->
                    @foreach (var branch in BranchTrace.Children.Where(x => x.Children.Any()))
                    {
                        <PropertyTable BranchTrace="@branch" />
                    }
                </div>
            </div>
        }
    </div>
}

@code {

    [CascadingParameter]
    public CaptureTraceDisplayContext DisplayContext { get; set; } = null!;

    [Parameter, EditorRequired]
    public CaptureTrace BranchTrace { get; set; }

    /// <summary>
    /// Names of collapsed ancestor branches skipped on the way down to <see cref="BranchTrace"/>,
    /// oldest first. Empty for a branch reached directly (not through a collapsed parent).
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> CollapsedLineage { get; set; } = [];

    HexPalette RootPalette => DisplayContext.Palettes[BranchTrace];

    /// <summary>
    /// Whether to skip <see cref="BranchTrace"/>'s own header/table and recurse straight into its
    /// children instead, for a structurally collapsible node. Off by default (every level shown
    /// explicitly); the "Hide collapsible nodes" setting opts into this noise-reducing behavior.
    /// </summary>
    bool ShouldCollapse => BranchTrace.IsCollapsible && RuntimeSettings.HideCollapsibleCaptureNodes;

    List<string> ChildLineage => [.. CollapsedLineage, BranchTrace.Name];

    /// <summary>
    /// The three distinct reasons two adjacent parts of a header can be joined, each rendered with
    /// its own separator glyph so a viewer isn't left guessing which relationship a bare ":" means:
    /// skipping past a collapsed ancestor, a <see cref="GlyphOneOfNode"/> choice resolving to one of
    /// its named alternatives, or a <see cref="DynamicGlyphNode"/> property resolving to its concrete
    /// runtime type.
    /// </summary>
    enum HeaderSeparatorKind { Collapsed, OneOf, Dynamic }

    /// <summary>One rendered header part, and (for every part but the first) which kind of relationship joins it to the part before it.</summary>
    readonly record struct HeaderSegment(string Text, HeaderSeparatorKind? SeparatorBefore);

    static string SeparatorGlyph(HeaderSeparatorKind kind) => kind switch
    {
        HeaderSeparatorKind.Collapsed => ":",
        HeaderSeparatorKind.OneOf => "»",
        HeaderSeparatorKind.Dynamic => "⇢",
        _ => ":",
    };

    /// <summary>
    /// Which kind of separator joins <see cref="BranchTrace"/>'s own name to the type it resolved
    /// to — null when it didn't resolve to anything (an ordinary named branch, no second part to show).
    /// </summary>
    HeaderSeparatorKind? OwnResolutionSeparatorKind =>
        BranchTrace.ResolvedNodeType == null ? null :
        BranchTrace.SourceNode is GlyphOneOfNode ? HeaderSeparatorKind.OneOf :
        BranchTrace.SourceNode is DynamicGlyphNode ? HeaderSeparatorKind.Dynamic :
        null;

    /// <summary>
    /// The header broken into its individually-styled parts: each collapsed ancestor skipped on the
    /// way down (joined by ":"), then <see cref="BranchTrace"/>'s own name, then — for a
    /// <see cref="DynamicGlyphNode"/> property or a <see cref="GlyphOneOfNode"/> choice — the resolved
    /// type it turned out to be (e.g. "Result ⇢ This Deals Damage", or "Card or Creature Type »
    /// Card Type"), joined by whichever glyph names that relationship. A dynamic property's declared
    /// name only says what role it plays in its parent, and a one-of's declared name only says it's a
    /// choice among alternatives; which type either actually resolved to is equally load-bearing
    /// information and shouldn't be hidden. Not a proper data-path step in either case, just a
    /// display-time fact appended to the step that already exists.
    /// </summary>
    List<HeaderSegment> HeaderSegments
    {
        get
        {
            var segments = new List<HeaderSegment>();

            foreach (var name in CollapsedLineage)
                segments.Add(new HeaderSegment(name.ToFriendlyCase(), segments.Count == 0 ? null : HeaderSeparatorKind.Collapsed));

            segments.Add(new HeaderSegment(BranchTrace.Name.ToFriendlyCase(), segments.Count == 0 ? null : HeaderSeparatorKind.Collapsed));

            if (OwnResolutionSeparatorKind is { } kind)
                segments.Add(new HeaderSegment(BranchTrace.ResolvedNodeTypeName.ToFriendlyCase(), kind));

            return segments;
        }
    }

    /// <summary>
    /// A terminal leaf's displayed name. Ordinarily this is just the leaf's own declared property
    /// name, but a direct child of a <see cref="GlyphOneOfNode"/> may be an anonymously-named
    /// alternative slot (e.g. "Alternative1" on a generic <see cref="OneOf{T1,T2}"/>) rather than a
    /// meaningful property name — so under a one-of, show the resolved type's own (non-title-cased)
    /// name instead, which is what actually matched.
    /// </summary>
    string LeafDisplayName(CaptureTrace leaf) =>
        BranchTrace.SourceNode is GlyphOneOfNode ? leaf.ResolvedNodeTypeName : leaf.Name;

    /// <summary>A terminal leaf's displayed "Type" column text - always an <see cref="EnumNode"/>, <see cref="IntNode"/>, or <see cref="BoolNode"/>, since those are the only node types <see cref="CaptureTrace.IsTerminal"/> is ever true for.</summary>
    static string TerminalTypeLabel(CaptureTrace leaf) =>
        leaf.SourceNode switch
        {
            EnumNode => "Enum",
            IntNode => "Int",
            BoolNode => "Bool",
            _ => leaf.SourceNode.GetType().Name,
        };

}
