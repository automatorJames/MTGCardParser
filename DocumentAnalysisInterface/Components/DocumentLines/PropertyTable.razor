@using DocumentAnalysisInterface.Components.CardLines
@inject RuntimeSettings RuntimeSettings

@if (ShouldCollapse)
{
    <!-- Directly render branch children of the collapsed parent branch, carrying its name
         forward so the next rendered header can show the collapsed lineage that led to it. -->
    @foreach (var child in BranchTrace.Children)
    {
        <PropertyTable BranchTrace=@child CollapsedLineage=@ChildLineage />
    }
}
else
{
    <div class="glyph-summary-branch" style="margin-top:16px" data-path=@BranchTrace.FullyQualifiedName>
        <div class="glyph-summary-header" data-path=@BranchTrace.FullyQualifiedName style=@(RootPalette.ToColorStyle(PaletteVariant.Sat))>
            <span class="glyph-type-name">@HeaderText</span>
        </div>

        @if (BranchTrace.Children.Any())
        {
            <div class="property-table-wrapper">
                <div 
                    class="content-box" data-path=@BranchTrace.FullyQualifiedName style=@(RootPalette.ToColorStyle(PaletteVariant.Dark))>

                    @{
                        var terminals = BranchTrace.Children.Where(x => x.IsTerminal).ToList();

                        if (terminals.Any())
                        {
                            <table class="property-capture-table">
                                <thead>
                                    <tr><th>Property</th><th>Type</th><th>Value</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var leaf in terminals)
                                    {
                                        var leafPaletteStyle = DisplayContext.Palettes[leaf].ToColorStyle();

                                        <tr data-path="@leaf.FullyQualifiedName">
                                            <td class="prop-capture-table-cell first-column" style=@leafPaletteStyle)>
                                                @LeafDisplayName(leaf)
                                            </td>
                                            <td class="prop-capture-table-cell type-column" style=@(leafPaletteStyle)>
                                                @leaf.NodeKind
                                            </td>
                                            <td class="prop-capture-table-cell value-column" style=@(leafPaletteStyle)>
                                                @leaf.ClrValue.ToString()
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    <!-- Recursively render tables for children that are also branches -->
                    @foreach (var branch in BranchTrace.Children.Where(x => x.Children.Any()))
                    {
                        <PropertyTable BranchTrace="@branch" />
                    }
                </div>
            </div>
        }
    </div>
}

@code {

    [CascadingParameter]
    public CaptureTraceDisplayContext DisplayContext { get; set; } = null!;

    [Parameter, EditorRequired]
    public CaptureTrace BranchTrace { get; set; }

    /// <summary>
    /// Names of collapsed ancestor branches skipped on the way down to <see cref="BranchTrace"/>,
    /// oldest first. Empty for a branch reached directly (not through a collapsed parent).
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> CollapsedLineage { get; set; } = [];

    HexPalette RootPalette => DisplayContext.Palettes[BranchTrace];

    /// <summary>
    /// Whether to skip <see cref="BranchTrace"/>'s own header/table and recurse straight into its
    /// children instead — the default, noise-reducing behavior for a structurally collapsible
    /// node. The "Show collapsed nodes" setting opts back into seeing every level explicitly.
    /// </summary>
    bool ShouldCollapse => BranchTrace.IsCollapsible && !RuntimeSettings.ShowCollapsedCaptureNodes;

    List<string> ChildLineage => [.. CollapsedLineage, BranchTrace.Name];

    /// <summary>
    /// <see cref="BranchTrace"/>'s own name, plus — for a <see cref="CaptureNodeKind.Dynamic"/>
    /// property or a <see cref="CaptureNodeKind.OneOf"/> choice — the resolved type it turned out
    /// to be (e.g. "Result: This Deals Damage", or "Card or Creature Type: Card Type"). A dynamic
    /// property's declared name only says what role it plays in its parent, and a one-of's declared
    /// name only says it's a choice among alternatives; which type either actually resolved to is
    /// equally load-bearing information and shouldn't be hidden. Not a proper data-path step in
    /// either case, just a display-time fact appended to the step that already exists.
    /// </summary>
    string OwnNameText =>
        BranchTrace.NodeKind is CaptureNodeKind.Dynamic or CaptureNodeKind.OneOf && BranchTrace.ResolvedNodeType != null
        ? $"{BranchTrace.Name.ToFriendlyCase()}: {BranchTrace.ResolvedNodeTypeName.ToFriendlyCase()}"
        : BranchTrace.Name.ToFriendlyCase();

    /// <summary>
    /// A terminal leaf's displayed name. Ordinarily this is just the leaf's own declared property
    /// name, but a direct child of a <see cref="CaptureNodeKind.OneOf"/> may be an anonymously-named
    /// alternative slot (e.g. "Alternative1" on a generic <see cref="OneOf{T1,T2}"/>) rather than a
    /// meaningful property name — so under a one-of, show the resolved type's own (non-title-cased)
    /// name instead, which is what actually matched.
    /// </summary>
    string LeafDisplayName(CaptureTrace leaf) =>
        BranchTrace.NodeKind == CaptureNodeKind.OneOf ? leaf.ResolvedNodeTypeName : leaf.Name;

    /// <summary>
    /// The header shown for a rendered (non-collapsed) branch. When it was only reached by
    /// skipping past one or more collapsed ancestors, the header chains their names together
    /// (e.g. "A: B: C") so the viewer can see there's a collapsed lineage behind it, rather than
    /// silently showing just "C" as if it were a top-level property.
    /// </summary>
    string HeaderText =>
        CollapsedLineage.Count == 0
        ? OwnNameText
        : string.Join(": ", CollapsedLineage.Select(x => x.ToFriendlyCase()).Append(OwnNameText));
}
