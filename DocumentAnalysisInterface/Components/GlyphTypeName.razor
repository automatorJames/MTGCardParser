<span data-path=@DataPath
      class="glyph-type-name"
      style="">
    @DisplayName
</span>

@code {
    [Parameter, EditorRequired]
    public Type GlyphType { get; set; }

    [Parameter]
    public string DataPath { get; set; }

    [Parameter]
    public string DisplayName { get; set; }

    protected override void OnInitialized()
    {
        DisplayName ??= GlyphType.Name.ToFriendlyCase(TitleDisplayOption.Sentence);
    }
}
