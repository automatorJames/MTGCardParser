@* The tooltip and definition viewer behind GlyphPreviews: the same ones the Grammar Tools page shows its definitions in. *@
@inject WorkspaceManager Workspaces
@inject ActiveCorpus Corpus
@inject RuntimeSettings RuntimeSettings
@implements IDisposable

<DefinitionTooltip Content="PreviewContent" />

@if (_viewer is not null)
{
    <DefinitionViewerDialog Name="@_viewer.Name" Kind="_viewer.Kind" Change="_viewer.Change" Committed="_viewer.Committed" Working="_viewer.Working"
                            GlyphType="_viewer.GlyphType" ResolveType="ResolveType" OnClose="() => _viewer = null" />
}

@code {
    [Parameter, EditorRequired] public GlyphPreviews Previews { get; set; }

    record ViewerState(DefinitionKind Kind, string Name, ChangeType? Change, object Committed, object Working, Type GlyphType);

    ViewerState _viewer;
    GlyphPreviews _subscribed;

    protected override void OnParametersSet()
    {
        if (_subscribed == Previews)
            return;

        if (_subscribed is not null)
            _subscribed.ViewRequested -= OnViewRequested;

        _subscribed = Previews;
        _subscribed.ViewRequested += OnViewRequested;
    }

    void OnViewRequested(DefinitionKind kind, string name) =>
        _ = InvokeAsync(() =>
        {
            var (change, committed, working, glyphType) = Describe(kind, name);
            _viewer = new(kind, name, change, committed, working, glyphType);
            StateHasChanged();
        });

    /// <summary>
    /// A definition's change, its committed and working versions (either null where it doesn't exist), and - for a glyph -
    /// its built type in the grammar the page's captures come from, so the regex tabs show what matched them.
    /// </summary>
    (ChangeType? Change, object Committed, object Working, Type GlyphType) Describe(DefinitionKind kind, string name)
    {
        object Find(GrammarDefinition definition) =>
            kind == DefinitionKind.Glyph
                ? definition.Glyphs.FirstOrDefault(x => x.Name == name)
                : definition.Vocabularies.FirstOrDefault(x => x.Name == name);

        var workbench = Workspaces.Active;
        var change = workbench.Changes.FirstOrDefault(x => x.Kind == kind && x.Name == name)?.Change;
        Type glyphType = kind == DefinitionKind.Glyph && Corpus.Grammar is { } grammar && grammar.TryGetType(name, out var type) ? type : null;

        return (change, Find(workbench.CommittedDefinition), Find(workbench.WorkingDefinition), glyphType);
    }

    /// <summary>What each type a definition can name is, for coloring its C# as Visual Studio would.</summary>
    Func<string, CodeTypeKind?> ResolveType => DefinitionViews.TypeResolver(Workspaces.Active.WorkingDefinition, Workspaces.Active.CommittedDefinition);

    /// <summary>A definition's tooltip: a preview of it as the viewer's last chosen tab shows it.</summary>
    RenderFragment PreviewContent(DefinitionKind kind, string name)
    {
        var (change, committed, working, glyphType) = Describe(kind, name);

        return @<DefinitionPreview View="@RuntimeSettings.DefinitionView" Kind="kind" Change="change" Committed="committed" Working="working"
                                   GlyphType="glyphType" ResolveType="ResolveType" BlankLines="@(!RuntimeSettings.HideBlankLines)" LineNumbers="@RuntimeSettings.ShowLineNumbers" />;
    }

    public void Dispose()
    {
        if (_subscribed is not null)
            _subscribed.ViewRequested -= OnViewRequested;
    }
}
