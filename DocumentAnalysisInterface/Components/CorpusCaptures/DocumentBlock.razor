@using Glyphotype.RegexGeneration.Graph
@inject ActiveCorpus CorpusAnalyzer
@inject RuntimeSettings RuntimeSettings

<div class="document-capture-block">
    <div class="document-title-row">
        <div class="document-title @(RuntimeSettings.ShowCoverageStats ? "with-coverage" : "")">@ProcessedDocument.Document.Name</div>

        @if (RuntimeSettings.ShowCoverageStats)
        {
            var documentPercent = GetCoveragePercent(ProcessedDocument.CapturedWordCount, ProcessedDocument.WordCount);

            <div class="coverage-callout">
                <span class="callout-key">Coverage:</span>
                <span class="callout-value @CoverageDisplay.GetColorClass(documentPercent)">@CoverageDisplay.FormatPercent(documentPercent)</span>
            </div>
        }
    </div>

    @foreach (var line in ProcessedDocument.Lines)
    {
        var displayContext = new CaptureTraceDisplayContext(line, RuntimeSettings, CorpusAnalyzer.DigestedTextWithCaptureGlyphs);

        <CascadingValue @key=line.DataPath Value=line>
        <CascadingValue Value=displayContext>
            <div class="line-capture-block match-boundary">
                <div class="line-label dashed-border">
                    <span>Line #@(line.SourceText.LineIndex + 1)</span>

                    @if (RuntimeSettings.ShowCoverageStats)
                    {
                        var linePercent = GetCoveragePercent(line.CapturedWordCount, line.WordCount);

                        <span class="coverage-callout">
                            <span class="callout-key">Coverage:</span>
                            <span class="callout-value @CoverageDisplay.GetColorClass(linePercent)">@CoverageDisplay.FormatPercent(linePercent)</span>
                        </span>
                    }
                </div>
                <div class="line-container-parent" data-path=@line.DataPath>
                    <pre class="nested-underline-container" style=@GetLineHeightStyle(displayContext) data-path=@line.DataPath>
                        @foreach (var root in line.CaptureTraceRoots)
                        {
                            <SpanView CaptureTrace=@root />
                        }
                    </pre>

                    @foreach (var root in line.MatchedCaptureTraceRoots)
                    {
                        <PropertyTable BranchTrace=@root />
                    }
                </div>
            </div>
        </CascadingValue>
        </CascadingValue>
    }
</div>

@code {
    [Parameter]
    public ProcessedDocument ProcessedDocument { get; set; }

    static HashSet<string> _terminals = [".", ";", ".\"", ";\""];

    static double GetCoveragePercent(int capturedWordCount, int wordCount) =>
        wordCount == 0 ? 0 : 100.0 * capturedWordCount / wordCount;

    string GetLineHeightStyle(CaptureTraceDisplayContext displayContext)
    {
        // Line height, and the top-half crop of the extra space it adds, both off the shared
        // depth-to-pixel scale in DocumentLineMetrics — the same one SpanView's and EchoUnderline's
        // underline offsets come from, so the reserved space always matches what's drawn in it.
        int lh = CorpusCapturesFormatting.GetLineHeightPx(displayContext.MaxEffectiveDepth);
        double topCrop = CorpusCapturesFormatting.GetTopCropPx(displayContext.MaxEffectiveDepth);

        // --captured-text-color/--unmatched-text-color set once here so every SpanView in this
        // line's <pre> can just read them — the two text colors are static C# tuning
        // (DocumentTextPresentation), not per-capture like the rainbow underline color is.
        return $"line-height: {lh}px; --top-crop: -{topCrop}px; " +
               $"--captured-text-color: {DocumentTextPresentation.CapturedTextColorHex}; " +
               $"--unmatched-text-color: {DocumentTextPresentation.UnmatchedTextColorHex};";
    }
}