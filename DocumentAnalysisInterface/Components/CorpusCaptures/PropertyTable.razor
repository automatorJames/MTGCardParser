@using DocumentAnalysisInterface.Components.CorpusCaptures
@inject RuntimeSettings RuntimeSettings

@if (ShouldCollapse)
{
    <!-- Directly render branch children of the collapsed parent branch, carrying its own header
         segments forward so the next rendered header can show the collapsed lineage that led to it.
         EffectiveChildren, not Children, so this walks the exact same one child IsCollapsible counted
         (a repeat occurrence reads its structure off its representative and has no Children of its
         own, which would otherwise silently render nothing at all here). -->
    @foreach (var child in BranchTrace.EffectiveChildren)
    {
        <PropertyTable BranchTrace=@child CollapsedLineage=@LineageFor(child) SeparatorFromLineage=@SeparatorFor(child) />
    }
}
else
{
    <!-- No data-path on the branch or header wrapper: each header part below carries its own, and
         corpus-captures.js collects every data-path ancestor of whatever's hovered - a wrapper path
         here (always the deepest, most specific one) would be swept up by hovering ANY part, so the
         leading parts could never highlight without the trailing ones coming along too. The
         content-box inside still carries the same path, so hovering the table body is unchanged. -->
    <div class="glyph-summary-branch" style="margin-top:16px">
        <div class="glyph-summary-header" style=@(RootPalette.ToColorStyle(PaletteVariant.Sat))>
            <span class="glyph-type-name">
                @{ var segments = HeaderSegments; }
                @for (var i = 0; i < segments.Count; i++)
                {
                    var segment = segments[i];
                    var isDim = (segments.Count - 1 - i) % 2 != 0;

                    if (segment.SeparatorBefore is { } separatorKind)
                    {
                        @(" ")<span class="header-separator" data-path=@segment.DataPath>@SeparatorGlyph(separatorKind)</span>@(" ")
                    }
                    <span class="header-part @(isDim ? "header-part-dim" : "")" data-path=@segment.DataPath>@segment.Text</span>
                }
            </span>
        </div>

        @if (BranchTrace.Children.Any())
        {
            <div class="property-table-wrapper">
                <div 
                    class="content-box" data-path=@BranchTrace.FullyQualifiedName style=@(RootPalette.ToColorStyle(PaletteVariant.Dark))>

                    @{
                        // One row per real occurrence: a terminal child nested under a repeated
                        // ("*"-quantified) ancestor can capture more than once (e.g. two keywords in
                        // one ManyOf<Buff> list) - every occurrence shares this one table position,
                        // distinguished by PositionLabel below, rather than getting a branch of its own.
                        var terminals = BranchTrace.Children.Where(x => x.IsTerminal).SelectMany(x => x).ToList();

                        if (terminals.Any())
                        {
                            <table class="property-capture-table">
                                <thead>
                                    <tr><th>Property</th><th>Type</th><th>Value</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var leaf in terminals)
                                    {
                                        var leafPaletteStyle = DisplayContext.Palettes[PaletteKey(leaf)].ToColorStyle();

                                        <tr data-path="@leaf.HoverPath">
                                            <td class="prop-capture-table-cell first-column" style=@leafPaletteStyle)>
                                                @LeafDisplayName(leaf)@PositionLabel(leaf)
                                            </td>
                                            <td class="prop-capture-table-cell type-column" style=@(leafPaletteStyle)>
                                                @TerminalTypeLabel(leaf)
                                            </td>
                                            <td class="prop-capture-table-cell value-column" style=@(leafPaletteStyle)>
                                                @leaf.ClrValue.ToString()
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    <!-- Recursively render tables for children that are also branches. -->
                    @foreach (var branch in BranchTrace.Children.Where(x => x.Children.Any()))
                    {
                        <PropertyTable BranchTrace="@branch" />
                    }
                </div>
            </div>
        }
    </div>
}

@code {

    [CascadingParameter]
    public CaptureTraceDisplayContext DisplayContext { get; set; } = null!;

    [Parameter, EditorRequired]
    public CaptureTrace BranchTrace { get; set; }

    /// <summary>
    /// The header parts contributed by the collapsed ancestor branches skipped on the way down to
    /// <see cref="BranchTrace"/>, oldest first — each already carrying the separator that joins it to
    /// the part before it and the data-path it stands for. Empty for a branch reached directly (not
    /// through a collapsed parent).
    /// </summary>
    [Parameter]
    public IReadOnlyList<HeaderSegment> CollapsedLineage { get; set; } = [];

    /// <summary>
    /// Which separator joins <see cref="BranchTrace"/>'s own name to the last of
    /// <see cref="CollapsedLineage"/> — normally ":", but the one-of/dynamic glyph that collapsed
    /// straight into this branch hands down its own "»"/"⇢" instead, so the header still says which
    /// relationship led here (see <see cref="LineageFor"/>). Meaningless, and ignored, when
    /// <see cref="CollapsedLineage"/> is empty.
    /// </summary>
    [Parameter]
    public HeaderSeparatorKind SeparatorFromLineage { get; set; } = HeaderSeparatorKind.Collapsed;

    HexPalette RootPalette => DisplayContext.Palettes[PaletteKey(BranchTrace)];

    /// <summary>
    /// The key to look <see cref="CaptureTraceDisplayContext.Palettes"/> up by: <see cref="CaptureTrace.Representative"/>
    /// when set, since <see cref="CaptureTraceDisplayContext"/> hands out one palette slot per distinct
    /// named group, not per repeat occurrence - every occurrence of a group nested inside a repeated
    /// ancestor (e.g. the "flying" and "first strike" rows under <c>SecondPlus &gt;&gt; Keyword</c>) is
    /// the same semantic capture slot, just a different repetition, so they share the one hue assigned
    /// to that slot's representative.
    /// </summary>
    static CaptureTrace PaletteKey(CaptureTrace trace) => trace.Representative ?? trace;

    /// <summary>
    /// " (position N)" for a leaf whose declared property sits beneath a <c>List&lt;&gt;</c>-typed
    /// ancestor - checked via the regex graph's own ancestor chain, not the capture tree, since
    /// "listable" is a structural fact about the property's declared shape (it could always have zero,
    /// one, or many occurrences), independent of how many times it actually occurred on this card. Shown
    /// even for a single occurrence so a viewer isn't left guessing whether "Keyword" here means exactly
    /// one keyword or happens to be a list that only matched once.
    /// </summary>
    static string PositionLabel(CaptureTrace leaf) =>
        leaf.IsListPosition
            ? $" (position {(leaf.SiblingIndex ?? 0) + 1})"
            : "";

    /// <summary>
    /// Whether to skip <see cref="BranchTrace"/>'s own header/table and recurse straight into its
    /// children instead, for a structurally collapsible node. Off by default (every level shown
    /// explicitly); the "Hide collapsible nodes" setting opts into this noise-reducing behavior.
    /// </summary>
    bool ShouldCollapse => BranchTrace.IsCollapsible && RuntimeSettings.HideCollapsibleCaptureNodes;

    /// <summary>
    /// <see cref="CollapsedLineage"/> with this (collapsed) branch's own part appended, to hand down to
    /// <paramref name="child"/>. A one-of/dynamic branch's resolved type normally earns a part of its
    /// own here too — but when the single child it collapses into IS that resolution (a one-of
    /// alternative declared under its own type's name), naming it twice in a row reads as a stutter, so
    /// it's left out and <see cref="SeparatorFor"/> folds it into the separator instead: "Buff »
    /// Transformed Type", not "Buff » Transformed Type : Transformed Type".
    /// </summary>
    List<HeaderSegment> LineageFor(CaptureTrace child)
    {
        var lineage = new List<HeaderSegment>(CollapsedLineage)
        {
            new(DisplayName(BranchTrace.Name), OwnSeparatorBefore, BranchTrace.FullyQualifiedName)
        };

        if (OwnResolutionSeparatorKind is { } kind && !ResolvesTo(child))
            lineage.Add(new(DisplayName(BranchTrace.ResolvedNodeTypeName), kind, BranchTrace.FullyQualifiedName));

        return lineage;
    }

    /// <summary>The <see cref="SeparatorFromLineage"/> to hand down to <paramref name="child"/> — see <see cref="LineageFor"/>.</summary>
    HeaderSeparatorKind SeparatorFor(CaptureTrace child) =>
        OwnResolutionSeparatorKind is { } kind && ResolvesTo(child) ? kind : HeaderSeparatorKind.Collapsed;

    /// <summary>Whether the type <see cref="BranchTrace"/> resolved to is the very thing <paramref name="child"/> is named for.</summary>
    bool ResolvesTo(CaptureTrace child) => BranchTrace.ResolvedNodeTypeName == child.Name;

    /// <summary>
    /// The three distinct reasons two adjacent parts of a header can be joined, each rendered with
    /// its own separator glyph so a viewer isn't left guessing which relationship a bare ":" means:
    /// skipping past a collapsed ancestor, a <see cref="GlyphOneOfNode"/> choice resolving to one of
    /// its named alternatives, or a <see cref="DynamicGlyphNode"/> property resolving to its concrete
    /// runtime type.
    /// </summary>
    public enum HeaderSeparatorKind { Collapsed, OneOf, Dynamic }

    /// <summary>
    /// One rendered header part: its display text, (for every part but the first) which kind of
    /// relationship joins it to the part before it, and the data-path of the capture it names — so
    /// each part highlights and lowlights on its own, in step with that capture's own span in the
    /// line above. A resolution part, which is a display-time fact rather than a step of its own,
    /// shares the path of the part it resolves.
    /// </summary>
    public readonly record struct HeaderSegment(string Text, HeaderSeparatorKind? SeparatorBefore, string DataPath);

    static string SeparatorGlyph(HeaderSeparatorKind kind) => kind switch
    {
        HeaderSeparatorKind.Collapsed => ":",
        HeaderSeparatorKind.OneOf => "»",
        HeaderSeparatorKind.Dynamic => "⇢",
        _ => ":",
    };

    /// <summary>
    /// Which kind of separator joins <see cref="BranchTrace"/>'s own name to the type it resolved
    /// to — null when it didn't resolve to anything (an ordinary named branch, no second part to show).
    /// </summary>
    HeaderSeparatorKind? OwnResolutionSeparatorKind =>
        BranchTrace.ResolvedNodeType == null ? null :
        BranchTrace.SourceNode is GlyphOneOfNode ? HeaderSeparatorKind.OneOf :
        BranchTrace.SourceNode is DynamicGlyphNode ? HeaderSeparatorKind.Dynamic :
        null;

    /// <summary>
    /// The header broken into its individually-styled parts: each collapsed ancestor skipped on the
    /// way down (joined by ":"), then <see cref="BranchTrace"/>'s own name, then — for a
    /// <see cref="DynamicGlyphNode"/> property or a <see cref="GlyphOneOfNode"/> choice — the resolved
    /// type it turned out to be (e.g. "Result ⇢ This Deals Damage", or "Card or Creature Type »
    /// Card Type"), joined by whichever glyph names that relationship. A dynamic property's declared
    /// name only says what role it plays in its parent, and a one-of's declared name only says it's a
    /// choice among alternatives; which type either actually resolved to is equally load-bearing
    /// information and shouldn't be hidden. Not a proper data-path step in either case, just a
    /// display-time fact appended to the step that already exists.
    /// </summary>
    List<HeaderSegment> HeaderSegments
    {
        get
        {
            var segments = new List<HeaderSegment>(CollapsedLineage)
            {
                new(DisplayName(BranchTrace.Name), OwnSeparatorBefore, BranchTrace.FullyQualifiedName)
            };

            if (OwnResolutionSeparatorKind is { } kind)
                segments.Add(new HeaderSegment(DisplayName(BranchTrace.ResolvedNodeTypeName), kind, BranchTrace.FullyQualifiedName));

            return segments;
        }
    }

    /// <summary>Which separator (if any) precedes <see cref="BranchTrace"/>'s own name part — none when it's the first part of its header.</summary>
    HeaderSeparatorKind? OwnSeparatorBefore => CollapsedLineage.Count == 0 ? null : SeparatorFromLineage;

    /// <summary>
    /// A class or property name as displayed. Left exactly as declared by default, so what's on screen
    /// matches what's in the glyph definitions (and in the data-paths beside it); the "Friendly case"
    /// setting spaces both out into prose instead. Purely cosmetic either way - data-paths are always
    /// built from the declared names.
    /// </summary>
    string DisplayName(string declaredName) =>
        RuntimeSettings.UseFriendlyCaseNames ? declaredName.ToFriendlyCase() : declaredName;

    /// <summary>
    /// A terminal leaf's displayed name. Ordinarily this is just the leaf's own declared property
    /// name, but a direct child of a <see cref="GlyphOneOfNode"/> may be an anonymously-named
    /// alternative slot (e.g. "Alternative1" on a generic <see cref="OneOf{T1,T2}"/>) rather than a
    /// meaningful property name — so under a one-of, show the resolved type's own name instead, which
    /// is what actually matched.
    /// </summary>
    string LeafDisplayName(CaptureTrace leaf) =>
        DisplayName(BranchTrace.SourceNode is GlyphOneOfNode ? leaf.ResolvedNodeTypeName : leaf.Name);

    /// <summary>A terminal leaf's displayed "Type" column text - always an <see cref="EnumNode"/>, <see cref="IntNode"/>, or <see cref="BoolNode"/>, since those are the only node types <see cref="CaptureTrace.IsTerminal"/> is ever true for.</summary>
    static string TerminalTypeLabel(CaptureTrace leaf) =>
        leaf.SourceNode switch
        {
            EnumNode => "Enum",
            IntNode => "Int",
            BoolNode => "Bool",
            _ => leaf.SourceNode.GetType().Name,
        };

}
