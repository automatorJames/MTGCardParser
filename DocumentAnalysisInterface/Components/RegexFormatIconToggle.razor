<button type="button" class="regex-format-icon" style="color: @Value.GetColor();" data-tooltip="Regex format: @Value.GetDescription()" aria-label="Regex format: @Value.GetDescription()" @onclick="Cycle">
    <span class="oi oi-@Icon" aria-hidden="true"></span>
</button>

@code {
    static readonly RegexDisplayMode[] _modes = Enum.GetValues<RegexDisplayMode>();

    [Parameter, EditorRequired]
    public string Icon { get; set; }

    [Parameter]
    public RegexDisplayMode Value { get; set; }

    [Parameter]
    public EventCallback<RegexDisplayMode> ValueChanged { get; set; }

    Task Cycle()
    {
        var nextMode = _modes[(Array.IndexOf(_modes, Value) + 1) % _modes.Length];
        return ValueChanged.InvokeAsync(nextMode);
    }
}
