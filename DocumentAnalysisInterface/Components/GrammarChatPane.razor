@using DocumentAnalysisInterface.Agent
@implements IDisposable
@inject GrammarChat Chat
@inject IJSRuntime JS

@* Nothing at all unless there's a local agent to chat with. *@
@if (_available)
{
    var entries = Chat.Entries;
    var running = Chat.IsRunning;
    var steps = Chat.StepsPerRound;
    var stats = Chat.Stats;

    <aside class="chat-pane @(_open ? "open" : "")">
        <button class="chat-handle @(running ? "running" : "")" title="@(_open ? "Hide the agent" : "Work on the grammar with the local agent")" @onclick="Toggle">
            <span class="material-symbols-outlined">@(_open ? "chevron_right" : "smart_toy")</span>
            <span class="chat-handle-label">Agent</span>
        </button>

        <header class="chat-header">
            <h3>Grammar agent</h3>
            <span class="chat-state @(running ? "running" : "")">@(running ? "working…" : "idle")</span>
            <button class="link-button" disabled="@(running || entries.Count == 0)" title="Start a new conversation, forgetting this one" @onclick="Chat.Reset">new chat</button>
        </header>

        <ChatOptionsBar Chat="Chat" />

        @if (stats.TotalTokens > 0 || stats.FiveHour is not null || stats.SevenDay is not null)
        {
            <div class="chat-stats">
                @Stat("Context",
                    stats.ContextWindow is long window ? Percent((double)stats.ContextTokens / window) : Compact(stats.ContextTokens),
                    stats.ContextWindow is long size ? $"{Compact(stats.ContextTokens)} of {Compact(size)}" : "tokens",
                    stats.ContextWindow is long capacity ? (double)stats.ContextTokens / capacity : null,
                    "How much of what the model can hold the conversation takes up")

                @Stat("Tokens",
                    Compact(stats.TotalTokens),
                    $"{Compact(stats.OutputTokens)} written",
                    null,
                    $"This conversation's requests, added up: {stats.InputTokens:N0} read in new, {stats.CacheReadTokens:N0} read from cache, {stats.CacheWriteTokens:N0} written to cache, {stats.OutputTokens:N0} written out. At list prices, {stats.CostUsd:C2}.")

                @if (stats.FiveHour is UsageWindow fiveHour)
                {
                    @Stat("5-hour limit", Percent(fiveHour.Utilization), Resets(fiveHour), fiveHour.Utilization,
                        "How much of the account's five-hour allowance is spent - by everything that uses it, not only this chat")
                }

                @if (stats.SevenDay is UsageWindow sevenDay)
                {
                    @Stat("Weekly limit", Percent(sevenDay.Utilization), Resets(sevenDay), sevenDay.Utilization,
                        "How much of the account's weekly allowance is spent - by everything that uses it, not only this chat")
                }
            </div>
        }

        <div class="chat-entries" @ref="_entriesElement">
            @if (entries.Count == 0)
            {
                <p class="chat-hint">
                    The agent works on the active workspace through the app's own tools, as <code>/grammar</code> does in a terminal:
                    a round of steps, then it stops to check in. Each step it applies shows up under Working changes as it lands.
                </p>
            }

            <ChatEntryList Entries="entries" />
        </div>

        <footer class="chat-footer">
            <form @onsubmit="Send">
                <input class="chat-input" type="text" placeholder="A message - or instructions for the next round" @bind="_draft" @bind:event="oninput" />
            </form>

            <div class="chat-actions">
                <div class="round-button" title="Steps the agent applies before it stops to check in - 0 for no limit. The session's setting, so it holds for an agent in a terminal too.">
                    <button class="btn btn-sm btn-primary" disabled="@running" @onclick="RunRound">
                        @(Chat.HasRound ? "Next" : "Start") @(steps > 0 ? $"{steps} glyph{(steps == 1 ? "" : "s")}" : "round")
                    </button>
                    <input type="number" min="0" max="99" value="@steps" @onchange="SetSteps" />
                </div>

                @if (running)
                {
                    <button class="btn btn-sm btn-secondary" @onclick="Chat.Stop">Stop</button>
                }
                else
                {
                    <button class="btn btn-sm btn-secondary" disabled="@string.IsNullOrWhiteSpace(_draft)" @onclick="Send">Send</button>
                }
            </div>
        </footer>
    </aside>
}

@code {
    /// <summary>One figure of the conversation's stats: what it is, the figure, a line under it, and - for a share of something - a bar filled that far.</summary>
    RenderFragment Stat(string label, string value, string caption, double? share, string title) =>
        @<div class="chat-stat @Level(share)" title="@title">
            <span class="chat-label">@label</span>
            <span class="chat-stat-value">@value</span>
            <span class="chat-stat-bar @(share is null ? "none" : "")">
                @if (share is double filled)
                {
                    <span style="width: @(Math.Clamp(filled, 0, 1).ToString("P1", System.Globalization.CultureInfo.InvariantCulture).Replace(" ", ""))"></span>
                }
            </span>
            <span class="chat-stat-caption">@caption</span>
        </div>;

    /// <summary>How near its end a share is: worth a look past three quarters, pressing past nine tenths.</summary>
    static string Level(double? share) => share switch
    {
        >= 0.9 => "high",
        >= 0.75 => "raised",
        _ => "",
    };

    static string Percent(double share) => share.ToString("P0");

    /// <summary>A count of tokens in a few characters: 950, 24.1k, 1.2M.</summary>
    static string Compact(long tokens) => tokens switch
    {
        < 1_000 => tokens.ToString(),
        < 100_000 => (tokens / 1_000.0).ToString("0.#") + "k",
        < 1_000_000 => (tokens / 1_000.0).ToString("0") + "k",
        _ => (tokens / 1_000_000.0).ToString("0.#") + "M",
    };

    /// <summary>When an allowance starts over: the time if that's within a day, the day as well if it's further off.</summary>
    static string Resets(UsageWindow window)
    {
        if (window.ResetsAt is not DateTimeOffset resetsAt)
            return "";

        var local = resetsAt.ToLocalTime();
        return "resets " + local.ToString(local - DateTimeOffset.Now < TimeSpan.FromHours(20) ? "h:mm tt" : "ddd h tt");
    }

    bool _available;
    bool _open;

    /// <summary>Tells the page the pane slid in or out, so it can make room for it.</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    string _draft;
    ElementReference _entriesElement;

    protected override async Task OnInitializedAsync()
    {
        _available = (await Chat.GetStatusAsync()).IsAvailable;

        if (_available)
        {
            Chat.Changed += OnChatChanged;

            // A conversation under way is worth seeing at once.
            if (Chat.IsRunning)
                await SetOpen(true);
        }
    }

    public void Dispose() => Chat.Changed -= OnChatChanged;

    void OnChatChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_available && _open)
            await JS.InvokeVoidAsync("grammarChat.follow", _entriesElement, false);
    }

    Task Toggle() => SetOpen(!_open);

    Task SetOpen(bool open)
    {
        _open = open;
        return OpenChanged.InvokeAsync(open);
    }

    void RunRound()
    {
        Chat.RunRound(_draft);
        _draft = null;
    }

    void Send()
    {
        if (Chat.IsRunning)
            return;

        Chat.Send(_draft);
        _draft = null;
    }

    void SetSteps(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var steps))
            Chat.StepsPerRound = Math.Clamp(steps, 0, 99);
    }

}
