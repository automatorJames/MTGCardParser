@using DocumentAnalysisInterface.Agent
@using Glyphotype.Distiller.Agent
@implements IDisposable
@inject GrammarChat Chat
@inject IJSRuntime JS

@* Nothing at all unless there's a local agent to chat with. *@
@if (_available)
{
    var entries = Chat.Entries;
    var running = Chat.IsRunning;
    var round = Chat.Round;
    var stats = Chat.Stats;
    var contextWindow = Chat.ContextWindow;

    <aside class="chat-pane @(_open ? "open" : "")">
        <button class="chat-handle @(running ? "running" : "")" title="@(_open ? "Hide the agent" : "Work on the grammar with the local agent")" @onclick="Toggle">
            <span class="material-symbols-outlined">@(_open ? "chevron_right" : "smart_toy")</span>
            <span class="chat-handle-label">Agent</span>
        </button>

        <header class="chat-header">
            <h3>Grammar agent</h3>
            <span class="chat-state @(running ? "running" : "")">@(round is int number ? $"AI round {number} · {(Chat.IsStoppingAfterStep ? "finishing its step…" : "working…")}" : running ? "working…" : "idle")</span>
            <button class="link-button" disabled="@(running || entries.Count == 0)" title="Start a new conversation, forgetting this one" @onclick="Chat.Reset">new chat</button>
        </header>

        <div class="chat-settings">
            <ChatOptionsBar Chat="Chat" />

            <div class="chat-setting-row">
                <label class="chat-setting" title="How many tokens of context a round may build up before it hands off to a fresh session: the agent writes what the next session needs into the workspace's journal, and the round goes on from there. Every request rereads the whole context, so lower is cheaper; higher keeps more of what the agent was thinking.">
                    <span class="chat-label">Hand off at context</span>
                    <input type="number" min="20" max="900" step="10" value="@Chat.HandoffThousands" @onchange="SetHandoffThousands" />
                    <span class="chat-setting-unit">K tokens</span>
                </label>
            </div>
        </div>

        @if (stats.TotalTokens > 0 || stats.FiveHour is not null || stats.SevenDay is not null)
        {
            <div class="chat-stats">
                @Stat("Tokens",
                    Compact(stats.TotalTokens),
                    $"{Compact(stats.OutputTokens)} written",
                    null,
                    $"This conversation's requests, added up: {stats.InputTokens:N0} read in new, {stats.CacheReadTokens:N0} read from cache, {stats.CacheWriteTokens:N0} written to cache, {stats.OutputTokens:N0} written out. At list prices, {stats.CostUsd:C2}.")

                @Stat("Context",
                    contextWindow is long window ? Percent((double)stats.ContextTokens / window) : Compact(stats.ContextTokens),
                    contextWindow is long size ? $"{Compact(stats.ContextTokens)} of {Compact(size)}" : "tokens",
                    contextWindow is long capacity ? (double)stats.ContextTokens / capacity : null,
                    "How much of what the model can hold the conversation takes up")

                @if (stats.FiveHour is UsageWindow fiveHour)
                {
                    @Stat("5-hour limit", Percent(fiveHour.Utilization), Resets(fiveHour), fiveHour.Utilization,
                        "How much of the account's five-hour allowance is spent - by everything that uses it, not only this chat")
                }

                @if (stats.SevenDay is UsageWindow sevenDay)
                {
                    @Stat("Weekly limit", Percent(sevenDay.Utilization), Resets(sevenDay), sevenDay.Utilization,
                        "How much of the account's weekly allowance is spent - by everything that uses it, not only this chat")
                }
            </div>
        }

        <div class="chat-entries" @ref="_entriesElement">
            @if (entries.Count == 0)
            {
                <p class="chat-hint">
                    The agent works on the active workspace through the app's own tools, as <code>/grammar</code> does in a terminal.
                    Each start is an AI round: it works until it has applied the max steps, runs out of improvements, or is stopped.
                    Each step it applies shows up under Working changes as it lands.
                </p>
            }

            <ChatEntryList Entries="entries" />
        </div>

        <footer class="chat-footer">
            @if (Chat.RoundStartedAt is DateTimeOffset roundStarted)
            {
                var until = Chat.RoundEndedAt ?? DateTimeOffset.Now;

                <div class="round-clocks @(round is null ? "stopped" : "")">
                    <span class="round-clock" title="How long the round has run, from its start - or ran, once it's over">
                        <span class="material-symbols-outlined">timer</span> Round @Chat.LatestRound <span class="clock-time">@Clock(until - roundStarted)</span>
                    </span>
                    <span class="step-clock" title="How long the agent has been working toward this step, since the round began or its last step was applied">
                        Step @Chat.NextStepNumber <span class="clock-time">@Clock(until - (Chat.StepStartedAt ?? roundStarted))</span>
                    </span>
                </div>
            }

            <form @onsubmit="Send">
                <input class="chat-input" type="text" placeholder="A message - or instructions for the next round" @bind="_draft" @bind:event="oninput" />
            </form>

            <div class="chat-actions">
                <div class="round-control">
                    @if (running)
                    {
                        var afterStep = Chat.StopsAfterStep;
                        var stopping = Chat.IsStoppingAfterStep;

                        <div class="stop-split">
                            <button class="btn btn-sm round-toggle stop" disabled="@(afterStep && stopping)"
                                    title="@(afterStep ? StopAfterStepTitle : StopNowTitle)" @onclick="StopAsLastUsed">
                                <span class="material-symbols-outlined">@(afterStep ? "last_page" : "stop")</span> @(afterStep ? stopping ? "Finishing step…" : "Stop after step" : "Stop now")
                            </button>
                            <button class="btn btn-sm stop-choice" title="Choose how to stop" @onclick="() => _stopMenuOpen = !_stopMenuOpen">
                                <span class="material-symbols-outlined">arrow_drop_up</span>
                            </button>

                            @if (_stopMenuOpen)
                            {
                                <div class="stop-menu-backdrop" @onclick="() => _stopMenuOpen = false"></div>
                                <div class="stop-menu">
                                    <button class="stop-menu-item" title="@StopNowTitle" @onclick="StopNow">
                                        <span class="material-symbols-outlined">stop</span> Stop now
                                    </button>
                                    <button class="stop-menu-item" disabled="@stopping" title="@StopAfterStepTitle" @onclick="StopAfterStep">
                                        <span class="material-symbols-outlined">last_page</span> Stop after step
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary round-toggle" title="Start an AI round, with the message as its instructions" @onclick="StartRound">
                            <span class="material-symbols-outlined">play_arrow</span> Start AI
                        </button>
                    }

                    <label class="max-steps" title="Steps the agent applies in a round before it stops - empty for no limit. The session's setting, so it holds for an agent in a terminal too.">
                        <span class="chat-label">Max steps</span>
                        <span class="max-steps-field">
                            <input type="number" min="1" max="99" placeholder="∞" value="@Chat.MaxSteps" @onchange="SetMaxSteps" />
                            @if (Chat.MaxSteps is not null)
                            {
                                <button type="button" class="max-steps-clear" title="Clear - no limit" @onclick="ClearMaxSteps" @onclick:preventDefault>
                                    <span class="material-symbols-outlined">close</span>
                                </button>
                            }
                        </span>
                    </label>

                    <span class="asks-approval" title="Whether the agent stops to ask your approval for a step that breaks the step rules. Off, it approves such a step itself and says why in the step - for sessions left to run. Read as a session starts.">
                        <Switch Value="Chat.AsksApproval" ValueChanged="x => Chat.AsksApproval = x" Label="Ask approval" />
                    </span>
                </div>

                <button class="btn btn-sm btn-secondary" disabled="@(running || string.IsNullOrWhiteSpace(_draft))" title="Say something to the agent without starting a round" @onclick="Send">Send</button>
            </div>

            <div class="focus-row" role="radiogroup" aria-label="Focus">
                @foreach (var focus in Enum.GetValues<AgentFocus>())
                {
                    var chosen = Chat.Focus == focus;

                    <button type="button" role="radio" aria-checked="@(chosen ? "true" : "false")" class="focus-tab focus-@focus.ToString().ToLowerInvariant() @(chosen ? "chosen" : "")"
                            title="@FocusTitle(focus)" @onclick="() => Chat.Focus = focus">
                        @GrammarChat.FocusName(focus)
                    </button>
                }
            </div>
        </footer>
    </aside>
}

@code {
    /// <summary>One figure of the conversation's stats: what it is, the figure, a line under it, and - for a share of something - a bar filled that far.</summary>
    RenderFragment Stat(string label, string value, string caption, double? share, string title) =>
        @<div class="chat-stat @Level(share)" title="@title">
            <span class="chat-label">@label</span>
            <span class="chat-stat-value">@value</span>
            <span class="chat-stat-bar @(share is null ? "none" : "")">
                @if (share is double filled)
                {
                    <span style="width: @(Math.Clamp(filled, 0, 1).ToString("P1", System.Globalization.CultureInfo.InvariantCulture).Replace(" ", ""))"></span>
                }
            </span>
            <span class="chat-stat-caption">@caption</span>
        </div>;

    /// <summary>How near its end a share is: worth a look past three quarters, pressing past nine tenths.</summary>
    static string Level(double? share) => share switch
    {
        >= 0.9 => "high",
        >= 0.75 => "raised",
        _ => "",
    };

    static string Percent(double share) => share.ToString("P0");

    static string Compact(long tokens) => StepFigures.Compact(tokens);

    /// <summary>A stopwatch's reading: 04:07, or 1:04:07 past the hour.</summary>
    static string Clock(TimeSpan elapsed) =>
        elapsed < TimeSpan.Zero ? "00:00"
        : elapsed.TotalHours >= 1 ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:00}:{elapsed.Seconds:00}"
        : $"{elapsed.Minutes:00}:{elapsed.Seconds:00}";

    /// <summary>Ticks the stopwatches over once a second, while a round runs.</summary>
    Timer _clockTimer;

    void Tick(object state)
    {
        if (Chat.Round is not null)
            _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>When an allowance starts over: the time if that's within a day, the day as well if it's further off.</summary>
    static string Resets(UsageWindow window)
    {
        if (window.ResetsAt is not DateTimeOffset resetsAt)
            return "";

        var local = resetsAt.ToLocalTime();
        return "resets " + local.ToString(local - DateTimeOffset.Now < TimeSpan.FromHours(20) ? "h:mm tt" : "ddd h tt");
    }

    bool _available;
    bool _open;

    /// <summary>Tells the page the pane slid in or out, so it can make room for it.</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    string _draft;
    ElementReference _entriesElement;

    protected override async Task OnInitializedAsync()
    {
        _available = (await Chat.GetStatusAsync()).IsAvailable;

        if (_available)
        {
            Chat.Changed += OnChatChanged;
            _clockTimer = new Timer(Tick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

            // A conversation under way is worth seeing at once.
            if (Chat.IsRunning)
                await SetOpen(true);
        }
    }

    public void Dispose()
    {
        Chat.Changed -= OnChatChanged;
        _clockTimer?.Dispose();
    }

    void OnChatChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_available && _open)
            await JS.InvokeVoidAsync("grammarChat.follow", _entriesElement, false);
    }

    Task Toggle() => SetOpen(!_open);

    Task SetOpen(bool open)
    {
        _open = open;
        return OpenChanged.InvokeAsync(open);
    }

    void StartRound()
    {
        Chat.StartRound(_draft);
        _draft = null;
    }

    bool _stopMenuOpen;

    const string StopNowTitle = "Stop the agent where it is - steps it has applied stay applied";
    const string StopAfterStepTitle = "Let the agent finish the step it's working on, then stop: it applies that step, summarizes the round, and waits";

    void StopAsLastUsed()
    {
        if (Chat.StopsAfterStep)
            StopAfterStep();
        else
            StopNow();
    }

    void StopNow()
    {
        _stopMenuOpen = false;
        Chat.StopNow();
    }

    void StopAfterStep()
    {
        _stopMenuOpen = false;
        Chat.StopAfterStep();
    }

    /// <summary>What a focus has the agent weigh, for its tab's tooltip.</summary>
    static string FocusTitle(AgentFocus focus) => (focus switch
    {
        AgentFocus.Coverage => "Coverage: the agent favors covering the most words, even at some cost in bits - with general frames, spelling out text literally only once nothing more general is left",
        AgentFocus.Compression => "Compression: the agent favors the steps that take the most bits off, and cheaper covers for glyphs costing more than they save",
        AgentFocus.HotSpots => "Hot spots: the agent works down the residual hot spots from the costliest, covering each one's family of lines",
        AgentFocus.Refine => "Refine: the agent favors generalizing the glyphs there are - merging, extracting shared parts, promoting vocabularies - in steps that also cover more words",
        _ => "Default: the agent chooses its targets as the guide and the workspace's guidance lead it to",
    }) + ". Read as a session starts, so a change holds from the next round on.";

    void Send()
    {
        if (Chat.IsRunning)
            return;

        Chat.Send(_draft);
        _draft = null;
    }

    void SetHandoffThousands(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var thousands))
            Chat.HandoffThousands = thousands;
    }

    /// <summary>Empty, or anything short of a step, for no limit.</summary>
    void ClearMaxSteps() => Chat.MaxSteps = null;

    void SetMaxSteps(ChangeEventArgs e) =>
        Chat.MaxSteps = int.TryParse(e.Value?.ToString(), out var steps) && steps > 0 ? Math.Min(steps, 99) : null;

}
