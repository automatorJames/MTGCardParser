@using Glyphotype.RegexGeneration.Graph.Nodes
@inject RuntimeSettings RuntimeSettings
@if (CaptureTrace != null)
{
    <span class=@GetClass() style=@GetStyle() data-path=@CaptureTrace.FullyQualifiedName>
        @{
            var cursor = 0;

            foreach (var child in CaptureTrace.Children.OrderBy(c => c.Index))
            {
                var relativeChildStart = child.Index - CaptureTrace.Index;

                if (relativeChildStart > cursor)
                {
                    <text>@CaptureTrace.CaptureContext.SourceText.Substring(CaptureTrace.Index + cursor, relativeChildStart - cursor)</text>
                }

                <SpanView CaptureTrace=@child />

                cursor = child.End - CaptureTrace.Index;
            }

            if (cursor < CaptureTrace.Length)
            {
                <text>@CaptureTrace.CaptureContext.SourceText.Substring(CaptureTrace.Index + cursor, CaptureTrace.Length - cursor)</text>
            }
        }
    </span>
}

@code {
    [CascadingParameter]
    public ProcessedLine ProcessedLine { get; set; } = null!;

    [Parameter, EditorRequired]
    public CaptureTrace CaptureTrace { get; set; } = null!;

    /// <summary>
    /// Whether this node should render as a flat leaf instead of its own nested-underline level.
    /// The model's own <see cref="CaptureTrace.IsCollapsible"/> is a structural fact (this node
    /// is a pure pass-through with no scalar of its own) independent of display preference; the
    /// "Show collapsed nodes" setting lets a viewer opt back into seeing those pass-through
    /// levels when they want the full lineage instead of the noise-reduced default.
    /// </summary>
    bool IsEffectivelyCollapsible => CaptureTrace.IsCollapsible && !RuntimeSettings.ShowCollapsedCaptureNodes;

    string GetClass()
    {
        if (CaptureTrace is RootCaptureTrace root && root.IsUnmatchedString)
            return "";

        var classes = new List<string>();

        if (CaptureTrace.Children.Any() && !IsEffectivelyCollapsible)
            classes.Add("nested-underline");

        if (CaptureTrace.IsTerminal)
            classes.Add("prop-capture-overline");

        //if (node is SpanSubLeaf spanSubLeaf)
        //    classes.Add("dashed-line");

        //if (node.ElementType == TokenAnalysisElementType.PlaceholderLeaf)
        //    classes.Add("dotted-line");

        return string.Join(" ", classes);
    }

    string GetStyle()
    {
        if (CaptureTrace is RootCaptureTrace root && root.IsUnmatchedString)
            return "";

        // Every node gets its own positional rainbow color and depth-scaled padding-bottom —
        // including "nested-underline" containers, not just leaves/collapsed nodes. A container's
        // border-bottom is what actually paints its underline level, so without its own --color
        // it falls back to currentColor (indistinguishable from every other unstyled level), and
        // without its own depth-scaled padding it sits at the CSS class's flat default instead of
        // stacking below the levels nested inside it.
        var style = new System.Text.StringBuilder();

        style.Append(ProcessedLine.CaptureTracePositionalPalettes[CaptureTrace].ToColorStyle());
        var paddingBottom = 2 + (ProcessedLine.CaptureTraceNestedDepths[CaptureTrace] * 6);
        style.Append($" padding-bottom: {paddingBottom}px;");

        return style.ToString();
    }
}