@page "/type-regex"
@inject DocumentCorpusAnalyzer DocumentAnalyzer
@inject IJSRuntime JSRuntime
@inject RuntimeSettings RuntimeSettings
@using Microsoft.AspNetCore.Components

<style>
    :root {
        --hover-fade-duration: @(HoverTreatmentConfig.FadeDurationMs)ms;
        --lowlight-opacity: @(HoverTreatmentConfig.LowlightOpacity);
    }
</style>

<DeferredContent OnReady="InitHoverAsync">
    <div class="type-card-container">
        @foreach (var summary in GetFilteredSummaries())
        {
            var borderColorStyle = "color: var(--grey);";

            <div class="type-card" style=@borderColorStyle @key=summary.Type.Name>
                <div class="card-header">
                    <GlyphTypeName GlyphType=@summary.Type />
                    <span class="match-count @(summary.OccurrenceCount == 0 ? "zero" : "")">
                        <i class="matches-label">matches:</i> @summary.OccurrenceCount
                    </span>
                </div>

                <CopyButtonOverlay TextToCopy=@GetCopyText(summary)>
                    @if (RuntimeSettings.RegexFormat == RegexDisplayMode.Minified)
                    {
                        <FormattedRegex Lines=@summary.RegexGraph.BuiltRegex.ToRichMinifiedLines(summary.RegexGraph) BorderStyle=@(borderColorStyle + " white-space: pre-wrap;") />
                    }
                    else
                    {
                        var smartRegex = summary.RegexGraph.BuiltRegex.ToSmartRegex(summary, summary.RegexGraph, !RuntimeSettings.HideBlankLines, RuntimeSettings.RegexFormat);
                        <FormattedRegex Lines=@smartRegex.Lines BorderStyle=@borderColorStyle />
                    }
                </CopyButtonOverlay>

                @if (!RuntimeSettings.HideTypeTree)
                {
                    <TypeTreeView RegexGraph=@summary.RegexGraph />
                }
            </div>

        }
    </div>
</DeferredContent>

@code {
    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += OnSettingsChanged;
    }

    protected override Task OnInitializedAsync() =>
        // The corpus is warmed at startup (see Program.cs), so this normally resolves
        // immediately; awaiting it here just guards against the unlikely case a request
        // comes in before that finishes.
        DocumentAnalyzer.EnsureInitializedAsync();

    Task InitHoverAsync() => JSRuntime.InvokeVoidAsync("initializeTypeExpressionsHover", new
    {
        HoverTreatmentConfig.PathAncestorDimOpacity,
        HoverTreatmentConfig.LowlightOpacity,
        HoverTreatmentConfig.DebounceMs,
        HoverTreatmentConfig.FadeDurationMs,
        HoverTreatmentConfig.OvershootBrightnessBoost,
        HoverTreatmentConfig.OvershootDurationMs,
        HoverTreatmentConfig.OvershootSettleDurationMs,
    }).AsTask();

    private async void OnSettingsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// What the card's copy button copies: the raw minified regex for the Minified format, or - for
    /// every other format - the formatted regex with each line's "  #  "-style comment separator and
    /// everything to its right stripped off, leaving the bare extended/whitespace regex a copy-paster
    /// downstream typically wants without the commentary. Done here via plain string manipulation
    /// (rather than a Glyphotype rendering option) since this is purely a "what the copy button copies"
    /// GUI concern.
    /// </summary>
    string GetCopyText(GlyphOccurrenceSummary summary)
    {
        if (RuntimeSettings.RegexFormat == RegexDisplayMode.Minified)
            return summary.RegexGraph.BuiltRegex.MinifiedRegex;

        var formattedRegex = summary.RegexGraph.BuiltRegex
            .ToSmartRegex(summary, summary.RegexGraph, !RuntimeSettings.HideBlankLines, RuntimeSettings.RegexFormat)
            .ToString();

        return StripCommentColumn(formattedRegex);
    }

    /// <summary>
    /// Cuts each line at its first occurrence of <see cref="SmartRegexStaticRules.CommentBorderLineWithBuffer"/>
    /// (dropping the comment separator and everything after it), then trims trailing padding spaces per
    /// line - left indentation is kept, only the right-hand padding that lined the comment column up goes.
    /// A line with no separator (e.g. a blank spacer line) is just trimmed as-is.
    /// </summary>
    static string StripCommentColumn(string formattedRegex)
    {
        var lines = formattedRegex.Split(["\r\n"], StringSplitOptions.None);

        for (int i = 0; i < lines.Length; i++)
        {
            var separatorIndex = lines[i].IndexOf(SmartRegexStaticRules.CommentBorderLineWithBuffer, StringComparison.Ordinal);
            var line = separatorIndex >= 0 ? lines[i][..separatorIndex] : lines[i];
            lines[i] = line.TrimEnd();
        }

        return string.Join("\r\n", lines);
    }

    List<GlyphOccurrenceSummary> GetFilteredSummaries()
    {
        List<GlyphOccurrenceSummary> filteredSummaries = DocumentAnalyzer.GlyphOccurrenceSummaries.Values.ToList();

        filteredSummaries = RuntimeSettings.OrderByOccurrenceCount
            ? filteredSummaries.OrderByDescending(x => x.OccurrenceCount).ToList()
            : filteredSummaries.OrderBy(x => x.TypeNameFriendly, StringComparer.OrdinalIgnoreCase).ToList();

        if (RuntimeSettings.HideRegexesWithZeroCaptures)
            filteredSummaries = filteredSummaries.Where(x => x.OccurrenceCount > 0).ToList();

        var searchTerm = RuntimeSettings.SearchTerm;

        if (string.IsNullOrWhiteSpace(searchTerm))
            return filteredSummaries;

        var term = searchTerm.Trim();

        return filteredSummaries
            .Where(x =>
                x.Type.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || x.TypeNameFriendly.Contains(term, StringComparison.OrdinalIgnoreCase)
                || x.RegexGraph.BuiltRegex.MinifiedRegex.Contains(term, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
