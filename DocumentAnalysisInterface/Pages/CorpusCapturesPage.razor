@page "/"
@page "/corpus-captures"
@inject IJSRuntime JSRuntime
@inject ActiveCorpus DocumentAnalyzer
@inject RuntimeSettings RuntimeSettings
@inject DocumentAnalysisInterface.Agent.LineChats LineChats
@inject DocumentAnalysisInterface.Agent.LocalAgent LocalAgent
@inject WorkspaceManager Workspaces
@implements IAsyncDisposable

<DeferredContent OnReady="InitHoverAsync">
    <div class="corpus-captures-container" id="corpus-captures"
         style="--corpus-captures-max-width: @(CorpusCapturesLayout.ContentMaxWidthPx)px">
        @* Keyed by the processed document itself, not its name: a new analysis (another workspace's grammar, or a re-score)
           brings new documents, and their blocks are built fresh - patching the old ones in place would cascade the new
           line's display context into spans still holding the old grammar's captures. *@
        @foreach (var document in GetFilteredDocuments())
        {
            <DocumentBlock @key=document ProcessedDocument=document ShowAgentButtons=@ShowAgentButtons />
        }
    </div>
</DeferredContent>

@* Previews what a line agent made, on hover, as Grammar Tools previews its definitions. *@
@if (ShowAgentButtons)
{
    <DefinitionTooltip Content="PreviewContent" />
}

@if (_debugTextSegment != null)
{
    <DebugRegexDialog TextSegment=@_debugTextSegment OnClose="CloseDebugRegexDialog" />
}

@code {
    string _debugTextSegment;
    DotNetObjectReference<CorpusCapturesPage> _selfRef;

    /// <summary>Whether there's a local agent to write a line's glyphs.</summary>
    bool _agentAvailable;

    /// <summary>Whether lines get the agent button: when it's turned on, and there's an agent to do the work.</summary>
    bool ShowAgentButtons => RuntimeSettings.ShowLineAgentButtons && _agentAvailable;

    protected override void OnInitialized()
    {
        RuntimeSettings.OnChanged += StateHasChanged;
        DocumentAnalyzer.Changed += OnCorpusChanged;
        LineChats.Changed += OnLineChatsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Resolves at once while the grammar shown is the one the corpus was analyzed with at startup (see
        // Program.cs); for another workspace's grammar, it waits for that to be scored and analyzed.
        await DocumentAnalyzer.EnsureInitializedAsync();

        _agentAvailable = (await LocalAgent.GetStatusAsync()).IsAvailable;
    }

    /// <summary>A definition's tooltip: a preview of it as the definition viewer's last chosen tab shows it - the same tab, here and in Grammar Tools.</summary>
    RenderFragment PreviewContent(DefinitionKind kind, string name)
    {
        var workbench = Workspaces.Active;
        var description = DefinitionViews.Describe(workbench, kind, name);

        return @<DefinitionPreview View="@RuntimeSettings.DefinitionView" Kind="kind" Change="description.Change" Committed="description.Committed"
                                   Working="description.Working" GlyphType="description.GlyphType"
                                   ResolveType="DefinitionViews.TypeResolver(workbench.WorkingDefinition, workbench.CommittedDefinition)"
                                   BlankLines="@(!RuntimeSettings.HideBlankLines)" LineNumbers="@RuntimeSettings.ShowLineNumbers" />;
    }

    /// <summary>A line's chat opened or closed: show it under its line, or take it away.</summary>
    void OnLineChatsChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>The active workspace's grammar changed (see <see cref="ActiveCorpus"/>): show the corpus as it tokenizes now.</summary>
    void OnCorpusChanged() =>
        _ = InvokeAsync(async () =>
        {
            await DocumentAnalyzer.EnsureInitializedAsync();
            StateHasChanged();
        });

    async Task InitHoverAsync()
    {
        // Wrapped defensively: if the SignalR circuit has gone stale (e.g. the tab sat idle long
        // enough for it to drop), these JS calls can throw TaskCanceledException. Letting that
        // escape unhandled from a component lifecycle method takes the whole circuit down: the
        // viewer gets the "an unhandled error has occurred" reload prompt over something that's
        // just going to reconnect and re-run this anyway. Not fixable from here — it's the circuit
        // itself timing out, not this call's logic — just not worth crashing over.
        try
        {
            await JSRuntime.InvokeVoidAsync("initDocumentCaptureHover");
            await JSRuntime.InvokeVoidAsync("initEchoHover");

            _selfRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initRegexDebugSelection", _selfRef, new
            {
                RegexDebugPresentation.SelectionHighlightColorHex,
                RegexDebugPresentation.SelectionHighlightOpacity,
            });
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <summary>
    /// Called from regex-debug.js when the "Debug regex" button over a word-boundary-corrected drag
    /// selection is clicked — opens the analysis dialog for that text.
    /// </summary>
    [JSInvokable]
    public Task OpenDebugRegexDialog(string textSegment)
    {
        _debugTextSegment = textSegment;
        return InvokeAsync(StateHasChanged);
    }

    void CloseDebugRegexDialog()
    {
        _debugTextSegment = null;
    }

    public async ValueTask DisposeAsync()
    {
        RuntimeSettings.OnChanged -= StateHasChanged;
        DocumentAnalyzer.Changed -= OnCorpusChanged;
        LineChats.Changed -= OnLineChatsChanged;

        if (_selfRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("disposeRegexDebugSelection");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
            {
                // Circuit already gone; nothing to clean up client-side.
            }

            _selfRef.Dispose();
        }
    }

    IEnumerable<ProcessedDocument> GetFilteredDocuments()
    {
        IEnumerable<ProcessedDocument> documents = DocumentAnalyzer.ProcessedDocuments;

        if (RuntimeSettings.HideFullyMatchedDocuments)
            // A document whose line the agent is working on stays, though the agent's glyphs cover it now.
            documents = documents.Where(x => !x.IsFullyMatched || ShowAgentButtons && LineChats.AnyFor(x.Document.Name));

        var searchTerm = RuntimeSettings.SearchTerm;
        if (string.IsNullOrWhiteSpace(searchTerm))
            return documents;

        var term = searchTerm.Trim();

        Func<ProcessedDocument, bool> containsPredicate = x =>
            x.Document.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            x.Lines.Any(line => line.Glyphs.Any(x => x.CaptureContext.SourceText.Contains(term, StringComparison.OrdinalIgnoreCase)));

        Func<ProcessedDocument, bool> startsWithPredicate = x =>
            x.Document.Name.StartsWith(term, StringComparison.OrdinalIgnoreCase) ||
            x.Lines.Any(line => line.Glyphs.Any(x => x.CaptureContext.SourceText.StartsWith(term, StringComparison.OrdinalIgnoreCase)));

        return documents
            .Where(containsPredicate)
            .OrderByDescending(startsWithPredicate)
            .ThenBy(c => c.Document.Name);
    }
}