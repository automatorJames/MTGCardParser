@page "/lowered"
@inject IJSRuntime JSRuntime
@inject ActiveCorpus DocumentAnalyzer
@inject LoweredCorpus Lowered
@inject RuntimeSettings RuntimeSettings
@inject WorkspaceManager Workspaces
@implements IAsyncDisposable

@if (!Lowered.IsAvailable)
{
    <p class="lowered-unavailable">This app has no lowering engine, so there's nothing to show here.</p>
}
else
{
    <DeferredContent OnReady="InitHoverAsync" Label="Lowering the corpus...">
        <div class="lowered-page" id="lowered-rules">
            <CascadingValue Value="_context" IsFixed="true">
                @if (_ready)
                {
                    <section class="lowered-summary">
                        <div class="lowered-figures">
                            <span class="figure"><span class="figure-key">Documents</span> <span class="figure-value">@Lowered.DocumentCount.ToString("N0")</span></span>
                            <span class="figure"><span class="figure-key">Fully lowered</span> <span class="figure-value @CoverageDisplay.GetColorClass(Percent(Lowered.FullyLoweredDocumentCount, Lowered.DocumentCount))">@CoverageDisplay.FormatPercent(Percent(Lowered.FullyLoweredDocumentCount, Lowered.DocumentCount))</span> <span class="figure-sub">@Lowered.FullyLoweredDocumentCount.ToString("N0")</span></span>
                            <span class="figure-separator">|</span>
                            <span class="figure"><span class="figure-key">Lines</span> <span class="figure-value">@Lowered.LineCount.ToString("N0")</span></span>
                            <span class="figure"><span class="figure-key">Fully lowered</span> <span class="figure-value @CoverageDisplay.GetColorClass(Percent(Lowered.FullyLoweredLineCount, Lowered.LineCount))">@CoverageDisplay.FormatPercent(Percent(Lowered.FullyLoweredLineCount, Lowered.LineCount))</span> <span class="figure-sub">@Lowered.FullyLoweredLineCount.ToString("N0")</span></span>
                            <span class="figure-separator">|</span>
                            <button class="blockers-toggle @(_showBlockers ? "open" : "")" @onclick="() => _showBlockers = !_showBlockers" title="The kinds that stayed opaque, most lines blocked first">
                                <span class="figure-key">Blockers</span> <span class="figure-value">@Lowered.Blockers.Count.ToString("N0")</span>
                            </button>
                        </div>
                        <div class="lowered-legend">
                            @foreach (var family in Lowered.Engine.Families)
                            {
                                <span class="legend-chip" style=@_context.FamilyPalettes[family].ToColorStyle()>@family</span>
                            }
                            <span class="legend-chip legend-status" style=@_context.TermPalette.ToColorStyle()>term</span>
                            <span class="legend-chip legend-status" style=@_context.ReferencePalette.ToColorStyle()>reference</span>
                            <span class="legend-chip legend-status legend-opaque" style=@_context.OpaquePalette.ToColorStyle()>opaque</span>
                        </div>
                        @if (_showBlockers)
                        {
                            <LoweringBlockers Blockers=@Lowered.Blockers Selected=@_blockerFilter SelectedChanged=@SetBlockerFilter />
                        }
                        @if (_blockerFilter is not null)
                        {
                            <div class="lowered-filter-note">
                                Showing documents with <span class="lowered-filter-kind">@_blockerFilter</span> opaque
                                <button class="lowered-filter-clear" @onclick="() => SetBlockerFilter(null)" title="Show every document">&times;</button>
                            </div>
                        }
                    </section>

                    var documents = GetFilteredDocuments().ToList();
                    var pageIndex = GetPageIndex(documents.Count);
                    <DocumentPager PageIndex=@pageIndex PageIndexChanged="GoToPage" PageSize=@LoweredLayout.DocumentsPerPage DocumentCount=@documents.Count />
                    @if (documents.Count == 0)
                    {
                        <p class="lowered-empty">No documents match.</p>
                    }
                    @foreach (var document in documents.Skip(pageIndex * LoweredLayout.DocumentsPerPage).Take(LoweredLayout.DocumentsPerPage))
                    {
                        <LoweredDocumentBlock @key=document Document=@LoweredOf(document) />
                    }
                    <DocumentPager PageIndex=@pageIndex PageIndexChanged="GoToPage" PageSize=@LoweredLayout.DocumentsPerPage DocumentCount=@documents.Count />
                }
                else
                {
                    <LoadingIndicator Label="Lowering the corpus..." />
                }
            </CascadingValue>
        </div>
    </DeferredContent>
    <GlyphPreviewViewer Previews="_previews" />
}

@code {
    GlyphPreviews _previews;
    LoweredDisplayContext _context;
    bool _ready;
    bool _showBlockers;
    string _blockerFilter;
    int _pageIndex;
    (string SearchTerm, bool HideFullyLowered, string Blocker) _pagedFilter;
    bool _scrollToTop;

    /// <summary>The trees of the documents on the page, made as they're first shown and kept while the page shows them.</summary>
    readonly Dictionary<ProcessedDocument, LoweredDocument> _lowered = [];

    protected override void OnInitialized()
    {
        if (!Lowered.IsAvailable)
            return;

        _previews = new(Workspaces);
        _context = new(Lowered.Engine, DocumentAnalyzer.Grammar, _previews);
        RuntimeSettings.OnChanged += OnSettingsChanged;
        DocumentAnalyzer.Changed += OnCorpusChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Lowered.IsAvailable)
            return;

        await Lowered.EnsureInitializedAsync();
        _ready = true;
    }

    LoweredDocument LoweredOf(ProcessedDocument document)
    {
        if (!_lowered.TryGetValue(document, out var lowered))
            _lowered[document] = lowered = Lowered.Lower(document);

        return lowered;
    }

    static double Percent(int part, int whole) => whole == 0 ? 0 : 100.0 * part / whole;

    IEnumerable<ProcessedDocument> GetFilteredDocuments()
    {
        var documents = DocumentAnalyzer.ProcessedDocuments;
        var summaries = Lowered.Summaries;
        IEnumerable<(ProcessedDocument Document, LoweredSummary Summary)> pairs = documents.Zip(summaries);

        if (RuntimeSettings.HideFullyLoweredDocuments)
            pairs = pairs.Where(x => !x.Summary.IsFullyLowered);

        if (_blockerFilter is { } kind)
            pairs = pairs.Where(x => x.Summary.Lines.Any(y => y.OpaqueKinds.Contains(kind)));

        var term = RuntimeSettings.SearchTerm?.Trim();

        if (!string.IsNullOrEmpty(term))
            pairs = pairs
                .Where(x => x.Document.Document.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || x.Document.Lines.Any(line => line.SourceText.FormattedText.Contains(term, StringComparison.OrdinalIgnoreCase))
                    || x.Summary.Lines.Any(line => line.OpaqueKinds.Any(k => k.Contains(term, StringComparison.OrdinalIgnoreCase))))
                .OrderByDescending(x => x.Document.Document.Name.StartsWith(term, StringComparison.OrdinalIgnoreCase))
                .ThenBy(x => x.Document.Document.Name);

        return pairs.Select(x => x.Document);
    }

    int GetPageIndex(int documentCount)
    {
        var filter = (RuntimeSettings.SearchTerm, RuntimeSettings.HideFullyLoweredDocuments, _blockerFilter);
        if (filter != _pagedFilter)
        {
            _pagedFilter = filter;
            _pageIndex = 0;
        }
        var lastPageIndex = Math.Max(0, (documentCount - 1) / LoweredLayout.DocumentsPerPage);
        return _pageIndex = Math.Min(_pageIndex, lastPageIndex);
    }

    void GoToPage(int pageIndex)
    {
        _pageIndex = pageIndex;
        _scrollToTop = true;
    }

    void SetBlockerFilter(string kind)
    {
        _blockerFilter = kind;
        _pageIndex = 0;
    }

    void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>The corpus was tokenized anew (another workspace's grammar, a re-score): its summaries and trees are made again.</summary>
    void OnCorpusChanged() =>
        _ = InvokeAsync(async () =>
        {
            _ready = false;
            _lowered.Clear();
            StateHasChanged();
            await Lowered.EnsureInitializedAsync();
            _context = new(Lowered.Engine, DocumentAnalyzer.Grammar, _previews);
            _ready = true;
            StateHasChanged();
        });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToTop)
            return;
        _scrollToTop = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    async Task InitHoverAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("initLoweredHover");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!Lowered.IsAvailable)
            return;

        RuntimeSettings.OnChanged -= OnSettingsChanged;
        DocumentAnalyzer.Changed -= OnCorpusChanged;
        try
        {
            await JSRuntime.InvokeVoidAsync("disposeLoweredHover");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
        }
    }
}
