@inject RuntimeSettings RuntimeSettings

<CustomDialog OnBackdropClick="Close">
    <TitleContent>Settings</TitleContent>
    <DialogContent>
        <div class="settings-section">
            <h3 class="settings-section-title">Document Lines</h3>
            <div class="settings-row">
                <Switch @bind-Value=@RuntimeSettings.HideFullyMatchedDocuments Label="Hide fully matched" />
            </div>
            <div class="settings-row">
                <Switch @bind-Value=@RuntimeSettings.ShowCollapsedCaptureNodes Label="Show collapsed nodes" />
            </div>
        </div>

        <div class="settings-section">
            <h3 class="settings-section-title">Type Regex</h3>
            <div class="settings-row radio-group">
                <span class="settings-row-label">Regex format</span>
                @foreach (var mode in Enum.GetValues<RegexDisplayMode>())
                {
                    <label class="radio-option">
                        <input type="radio" name="regex-format" checked="@(RuntimeSettings.RegexFormat == mode)"
                               @onchange="() => RuntimeSettings.RegexFormat = mode" />
                        @mode.GetDescription()
                    </label>
                }
            </div>
            <div class="settings-row">
                <Switch @bind-Value=@RuntimeSettings.HideRegexesWithZeroCaptures Label="Hide zero-capture types" />
            </div>
            <div class="settings-row">
                <Switch @bind-Value=@RuntimeSettings.HideBlankLines Label="Hide blank lines" />
            </div>
            <div class="settings-row">
                <Switch @bind-Value=@RuntimeSettings.HideTypeTree Label="Hide type tree" />
            </div>
        </div>

        <div class="settings-section">
            <h3 class="settings-section-title">Word Trees</h3>
            <div class="settings-row">
                <IntInput @bind-Value=RuntimeSettings.MinSpanOccurences Color=@ThemeColor.DarkGrey Label="Min occurr." />
            </div>
            <div class="settings-row">
                <IntInput @bind-Value=RuntimeSettings.MinSpanWords Color=@ThemeColor.DarkGrey Label="Min words" />
            </div>
            <div class="settings-row">
                <Switch @bind-Value=@RuntimeSettings.OrderByWordCount Label="Order by word count" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <button class="btn btn-primary" @onclick="Close">Done</button>
    </DialogActions>
</CustomDialog>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    Task Close() => OnClose.InvokeAsync();
}
