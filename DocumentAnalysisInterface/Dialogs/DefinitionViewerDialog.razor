@inject RuntimeSettings RuntimeSettings

<CustomDialog OnBackdropClick="Close" CloseOnEscape="true" ContainerStyle="max-width: min(1100px, 94vw);">
    <TitleContent>
        <div class="viewer-title">
            <span class="viewer-kind">@Kind.ToString().ToLowerInvariant()</span>
            <span>@Name</span>
            @if (Change is ChangeType change)
            {
                <span class="change-badge @change.ToString().ToLowerInvariant()">@change.ToString().ToLowerInvariant()</span>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <div class="viewer-tabs" role="tablist">
            @foreach (var tab in _tabs)
            {
                <button class="viewer-tab @(tab == _tab ? "active" : "")" role="tab" aria-selected="@(tab == _tab)" @onclick="() => Choose(tab)">
                    @DefinitionViews.Label(tab)
                    @if (tab == DefinitionView.Diff)
                    {
                        <span class="diff-stat added">+@_diff.Count(x => x.Kind == LineDiff.LineKind.Added)</span>
                        <span class="diff-stat removed">−@_diff.Count(x => x.Kind == LineDiff.LineKind.Removed)</span>
                    }
                </button>
            }
        </div>

        <div class="viewer-body">
            @switch (_tab)
            {
                case DefinitionView.CSharp:
                    <CopyButtonOverlay TextToCopy="@_csharp">
                        <pre class="code-view">@_csharp</pre>
                    </CopyButtonOverlay>
                    break;

                case DefinitionView.Json:
                    <CopyButtonOverlay TextToCopy="@_json">
                        <pre class="code-view">@_json</pre>
                    </CopyButtonOverlay>
                    break;

                case DefinitionView.FormattedRegex when _formattedRegex is not null:
                    <CopyButtonOverlay TextToCopy="@_formattedRegexText">
                        <FormattedRegex Lines="@_formattedRegex.Lines" ShowLineNumbers="@RuntimeSettings.ShowLineNumbers" />
                    </CopyButtonOverlay>
                    break;

                case DefinitionView.MinifiedRegex when _minifiedRegex is not null:
                    <CopyButtonOverlay TextToCopy="@_minifiedRegexText">
                        <FormattedRegex Lines="@_minifiedRegex" BorderStyle="white-space: pre-wrap; word-break: break-all;" />
                    </CopyButtonOverlay>
                    break;

                case DefinitionView.FormattedRegex or DefinitionView.MinifiedRegex:
                    <p class="viewer-note">@(_regexError ?? "The regex shows once the grammar this definition is in is built.")</p>
                    break;

                case DefinitionView.Diff:
                    <div class="diff-header">committed → working</div>
                    <CopyButtonOverlay TextToCopy="@_diffText">
                        <table class="diff-view">
                            <tbody>
                                @foreach (var line in _diff)
                                {
                                    var kind = line.Kind.ToString().ToLowerInvariant();
                                    <tr class="diff-line @kind">
                                        <td class="line-number">@line.OldNumber</td>
                                        <td class="line-number">@line.NewNumber</td>
                                        <td class="line-marker">@(line.Kind switch { LineDiff.LineKind.Added => "+", LineDiff.LineKind.Removed => "−", _ => "" })</td>
                                        <td class="line-text">@line.Text</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </CopyButtonOverlay>
                    break;
            }
        </div>

        @if (Change == ChangeType.Removed)
        {
            <p class="viewer-note">Removed from the working grammar: this is the committed definition.</p>
        }
    </DialogContent>
    <DialogActions>
        <button class="btn btn-secondary" @onclick="Close">Close</button>
    </DialogActions>
</CustomDialog>

@code {
    [Parameter, EditorRequired] public string Name { get; set; }

    [Parameter, EditorRequired] public DefinitionKind Kind { get; set; }

    /// <summary>How the working definition differs from the committed one, or null if it doesn't.</summary>
    [Parameter] public ChangeType? Change { get; set; }

    /// <summary>The committed definition (a <see cref="GlyphDefinition"/> or <see cref="VocabularyDefinition"/>), or null if there's none.</summary>
    [Parameter] public object Committed { get; set; }

    /// <summary>The working definition, or null if it's been removed.</summary>
    [Parameter] public object Working { get; set; }

    /// <summary>For a glyph: its type in the grammar it's shown from, built - for the regex tabs. Null while there's none to hand.</summary>
    [Parameter] public Type GlyphType { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    DefinitionView _tab;
    IReadOnlyList<DefinitionView> _tabs = [];
    string _csharp;
    string _json;
    SmartRegex _formattedRegex;
    string _formattedRegexText;
    List<SmartLine> _minifiedRegex;
    string _minifiedRegexText;
    string _regexError;
    IReadOnlyList<LineDiff.Line> _diff = [];
    string _diffText;

    protected override void OnParametersSet()
    {
        var shown = Working ?? Committed;
        _tabs = DefinitionViews.For(Kind, Change);
        _csharp = DefinitionViews.CSharp(shown);
        _json = DefinitionViews.Json(shown);
        _diff = Change == ChangeType.Modified ? LineDiff.Compare(DefinitionViews.CSharp(Committed), _csharp) : [];
        _diffText = DefinitionViews.DiffText(_diff);

        _formattedRegex = null;
        _minifiedRegex = null;
        _regexError = null;

        if (Kind == DefinitionKind.Glyph && GlyphType is not null)
        {
            try
            {
                _formattedRegex = DefinitionViews.FormattedRegex(GlyphType, !RuntimeSettings.HideBlankLines);
                _formattedRegexText = FormattedRegexCopy.GetCopyText(_formattedRegex.Lines);
                _minifiedRegex = GlyphTypeCache.GetRegexGraph(GlyphType).BuiltRegex.ToRichMinifiedLines(GlyphTypeCache.GetRegexGraph(GlyphType));
                _minifiedRegexText = DefinitionViews.MinifiedRegexText(GlyphType);
            }
            catch (Exception exception)
            {
                _formattedRegex = null;
                _minifiedRegex = null;
                _regexError = $"The regex couldn't be shown: {exception.Message}";
            }
        }

        // The tab last chosen, where this definition has it.
        _tab = _tabs.Contains(RuntimeSettings.DefinitionView) ? RuntimeSettings.DefinitionView : DefinitionView.CSharp;
    }

    void Choose(DefinitionView tab)
    {
        _tab = tab;
        RuntimeSettings.DefinitionView = tab;
    }

    Task Close() => OnClose.InvokeAsync();
}
