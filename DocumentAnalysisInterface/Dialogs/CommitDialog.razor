<CustomDialog OnBackdropClick="Close" ContainerStyle="max-width: min(1500px, 94vw);">
    <TitleContent>Commit working grammar to C#</TitleContent>
    <DialogContent>
        <p class="commit-summary">
            @Plan.Declarations.Count declaration change@(Plan.Declarations.Count == 1 ? "" : "s") across @Plan.Files.Count file@(Plan.Files.Count == 1 ? "" : "s") under <code>@SourceDirectory</code>.
            Only the changed declarations are rewritten; the rest of each file, and each declaration's doc comment, stay as they are.
        </p>

        @if (Plan.Conflicts.Count > 0)
        {
            <div class="conflicts">
                <p class="conflicts-summary">
                    @(Plan.Conflicts.Count == 1 ? "A definition this commit adds has a name" : $"{Plan.Conflicts.Count} definitions this commit adds have names") a type in the project already has:
                </p>
                <ul>
                    @foreach (var conflict in Plan.Conflicts)
                    {
                        <li>@conflict.Change.Kind.ToString().ToLowerInvariant() <strong>@conflict.Change.Name</strong> <span class="declaration-file">already in @Relative(conflict.ExistingPath)</span></li>
                    }
                </ul>
                <div class="conflict-choices">
                    @Choice(NameConflictResolution.AllowConflicts, "Do nothing", "Write them anyway - the names will clash")
                    @Choice(NameConflictResolution.RenameExisting, "Rename existing", $"The existing types get \"{SourceCommitter.LegacySuffix}\" appended")
                    @Choice(NameConflictResolution.RenameIncoming, "Rename incoming", $"The new definitions get \"{SourceCommitter.NewSuffix}\" appended, in the working grammar too")
                </div>
            </div>
        }

        <div class="file-list">
            @foreach (var file in Plan.Files)
            {
                var action = file.OriginalText is null ? "new" : file.NewText is null ? "deleted" : "edited";
                <div class="file-row"><span class="file-badge @action">@action</span> @Relative(file.Path)</div>
            }
        </div>

        <div class="declarations">
            @foreach (var edit in Plan.Declarations)
            {
                <details class="declaration" open="@(Plan.Declarations.Count <= 3)">
                    <summary>
                        <span class="change-badge @edit.Change.Change.ToString().ToLowerInvariant()">@edit.Change.Change</span>
                        @edit.Change.Kind.ToString().ToLowerInvariant() <strong>@edit.Change.Name</strong>
                        @if (edit.FilePath is not null)
                        {
                            <span class="declaration-file">@Relative(edit.FilePath)</span>
                        }
                    </summary>

                    @foreach (var note in edit.Notes)
                    {
                        <div class="declaration-note">@note</div>
                    }

                    <div class="before-after">
                        <div>
                            <span class="column-label">Before</span>
                            <pre>@(edit.Before ?? "(none)")</pre>
                        </div>
                        <div>
                            <span class="column-label">After</span>
                            <pre>@(edit.After ?? "(removed)")</pre>
                        </div>
                    </div>
                </details>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <button class="btn btn-secondary" @onclick="Close">Cancel</button>
        <button class="btn btn-primary" disabled="@(!Plan.IsResolved)" title="@(Plan.IsResolved ? "" : "Choose what to do about the name conflicts first")" @onclick="Commit">Write files</button>
    </DialogActions>
</CustomDialog>

@code {
    [Parameter, EditorRequired] public SourceCommitPlan Plan { get; set; }
    [Parameter, EditorRequired] public string SourceDirectory { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }

    /// <summary>The person chose what to do about the plan's <see cref="SourceCommitPlan.Conflicts"/> - for the plan to be made again doing it.</summary>
    [Parameter] public EventCallback<NameConflictResolution> OnResolve { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    string Relative(string path) => Path.GetRelativePath(SourceDirectory, path);

    RenderFragment Choice(NameConflictResolution resolution, string label, string description) =>
        @<label class="conflict-choice @(Plan.Resolution == resolution ? "chosen" : "")">
            <input type="radio" name="conflict-resolution" checked="@(Plan.Resolution == resolution)" @onchange="() => OnResolve.InvokeAsync(resolution)" />
            <span class="conflict-choice-label">@label</span>
            <span class="conflict-choice-description">@description</span>
        </label>;

    Task Commit() => OnCommit.InvokeAsync();

    Task Close() => OnClose.InvokeAsync();
}
