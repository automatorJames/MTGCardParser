@inject IJSRuntime JS

<div class="custom-dialog-backdrop" @onclick="HandleBackdropClick">
    <div class="custom-dialog-container" style="@ContainerStyle" @onclick:stopPropagation="true"
         tabindex="-1" @ref="_container" @onkeydown="HandleKeyDown">
        @if (TitleContent != null)
        {
            <div class="custom-dialog-header">
                @TitleContent
            </div>
        }
        <div class="custom-dialog-content">
            @DialogContent
        </div>
        <div class="custom-dialog-actions">
            @DialogActions
        </div>
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment TitleContent { get; set; }

    [Parameter]
    public RenderFragment DialogContent { get; set; }

    [Parameter]
    public RenderFragment DialogActions { get; set; }

    [Parameter]
    public EventCallback OnBackdropClick { get; set; }

    /// <summary>
    /// Raw CSS appended to the container's own inline style, e.g. to override its default
    /// max-width for one particular dialog without touching the shared default every other
    /// CustomDialog caller gets. Deliberately an inline style rather than a caller-supplied CSS
    /// class: .custom-dialog-container is rendered here, by CustomDialog, wrapping the caller's
    /// DialogContent — never a descendant of the caller's own scoped markup — so a caller's
    /// .razor.css ::deep rule (which only ever compiles to "[caller-scope] .selector", a
    /// descendant combinator) can never structurally match it, no matter the class name.
    /// </summary>
    [Parameter]
    public string ContainerStyle { get; set; }

    /// <summary>
    /// Whether Escape dismisses the dialog, the same way a backdrop click does (<see cref="OnBackdropClick"/>). Opt-in, since
    /// a dialog holding unsaved input (an editor) shouldn't lose it to a stray keypress. The dialog takes focus when it opens,
    /// so Escape works straight away - unless something inside it (a field the caller focused) already has it.
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; }

    ElementReference _container;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && CloseOnEscape)
            await JS.InvokeVoidAsync("focusUnlessWithin", _container);
    }

    private Task HandleBackdropClick() => OnBackdropClick.InvokeAsync();

    private Task HandleKeyDown(KeyboardEventArgs e) =>
        CloseOnEscape && e.Key == "Escape" ? OnBackdropClick.InvokeAsync() : Task.CompletedTask;
}